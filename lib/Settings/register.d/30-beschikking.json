{
  "components": {
    "registers": {
      "procest": {
        "schemas": [
          "beschikking",
          "stateMachineLog",
          "bezwaarTrigger",
          "mandaatRegeling"
        ]
      }
    },
    "schemas": {
      "beschikking": {
        "slug": "beschikking",
        "icon": "FileCertificateOutline",
        "version": "1.0.0",
        "x-schema-org-type": "schema:GovernmentPermit",
        "title": "Beschikking",
        "description": "Formal decision (Awb besluit) with full lifecycle: ontwerp -> akkoord-mandaat -> ondertekend -> verzonden -> ontvangen-bevestiging -> gearchiveerd. Immutable once ondertekend. State transitions are guarded by mandaat-verificatie (akkoord) and TSP-handtekening (onderteken) and logged via stateMachineLog.",
        "type": "object",
        "required": [
          "zaakId",
          "beschikkingType",
          "huidigeStatus"
        ],
        "properties": {
          "zaakId": {
            "type": "string",
            "description": "Back-reference to the procest case this beschikking belongs to",
            "facetable": true
          },
          "zaaktype": {
            "type": "string",
            "description": "Case type slug (e.g. wmo-melding, omgevingsvergunning)",
            "facetable": true
          },
          "beschikkingType": {
            "type": "string",
            "enum": [
              "toekenning",
              "afwijzing",
              "wijziging",
              "intrekking"
            ],
            "description": "Type of decision",
            "facetable": true
          },
          "kenmerk": {
            "type": "string",
            "maxLength": 255,
            "description": "User-visible decision number (e.g. Z/2026/04832/B01)"
          },
          "templateId": {
            "type": "string",
            "description": "BeschikkingTemplate identifier (Docudesk-bound)"
          },
          "ontwerpVersie": {
            "type": "integer",
            "default": 1,
            "description": "Auto-increment as the draft is re-rendered or field-edited"
          },
          "huidigeStatus": {
            "type": "string",
            "enum": [
              "ontwerp",
              "akkoord-mandaat",
              "ondertekend",
              "verzonden",
              "ontvangen-bevestiging",
              "gearchiveerd"
            ],
            "default": "ontwerp",
            "description": "Current state-machine status",
            "facetable": true
          },
          "bekendmakingDatum": {
            "type": "string",
            "format": "date",
            "description": "Date the beschikking becomes legally effective (Awb 3:41)"
          },
          "bezwaarTermijnEindDatum": {
            "type": "string",
            "format": "date",
            "description": "End of the 6-week bezwaartermijn (Awb 6:7), computed on verzending"
          },
          "herinneringDatum": {
            "type": "string",
            "format": "date",
            "description": "Reminder date, one week before bezwaarTermijnEindDatum"
          },
          "legesbedrag": {
            "type": "number",
            "default": 0,
            "description": "Leges amount associated with the decision"
          },
          "motivering": {
            "type": "string",
            "description": "Reasoning underpinning the decision",
            "x-translatable": false
          },
          "rechtsmiddelenClausule": {
            "type": "string",
            "description": "Standard rechtsmiddelen (appeal-rights) clause text"
          },
          "samengesteldeInhoud": {
            "type": "object",
            "description": "Rendered PDF/A-3 composition metadata",
            "properties": {
              "format": { "type": "string", "default": "pdf-a3" },
              "bestandId": { "type": "string", "description": "Nextcloud file id of the rendered PDF" },
              "checksumSha256": { "type": "string" },
              "paginas": { "type": "integer" }
            }
          },
          "geadresseerde": {
            "type": "object",
            "description": "Addressee (a citizen or a business). BSN/OIN are special-category identifiers and are masked when logged.",
            "properties": {
              "type": { "type": "string", "enum": ["burger", "bedrijf"] },
              "bsn": { "type": "string", "description": "Burger identifier (special category, masked in logs)" },
              "oin": { "type": "string", "description": "Business identifier" },
              "naam": { "type": "string" },
              "berichtenboxKanaal": { "type": "string", "enum": ["mijnoverheid", "eherkenning", "print-post"] },
              "berichtenboxBevestigd": { "type": "boolean", "default": false }
            }
          },
          "beslissing": {
            "type": "object",
            "description": "Decision content",
            "properties": {
              "soort": { "type": "string" },
              "onderwerp": { "type": "string" },
              "omvang": { "type": "string" },
              "ingangsdatum": { "type": "string", "format": "date" },
              "einddatum": { "type": "string", "format": "date" }
            }
          },
          "mandaatGegeven": {
            "type": "object",
            "description": "Point-in-time mandaat record captured at the akkoord step (ADR design D3)",
            "properties": {
              "mandaatregelingId": { "type": "string" },
              "mandaatNiveau": { "type": "string" },
              "akkoordDoor": { "type": "string", "description": "Nextcloud UID of the approver" },
              "akkoordDatum": { "type": "string", "format": "date-time" }
            }
          },
          "handtekening": {
            "type": "object",
            "description": "eIDAS-qualified electronic signature metadata; durably retained for future validation",
            "properties": {
              "tspProvider": { "type": "string" },
              "tspProviderEidasId": { "type": "string" },
              "ondertekenaar": { "type": "string" },
              "ondertekeningTijdstip": { "type": "string", "format": "date-time" },
              "soort": { "type": "string" },
              "certificaatSerienummer": { "type": "string" },
              "validatieRapportId": { "type": "string" }
            }
          },
          "verzending": {
            "type": "object",
            "description": "Berichtenbox delivery record",
            "properties": {
              "kanaal": { "type": "string" },
              "verzondenOp": { "type": "string", "format": "date-time" },
              "verzondenDoor": { "type": "string" },
              "berichtId": { "type": "string" },
              "ontvangstBevestigingOp": { "type": "string", "format": "date-time" },
              "leesBevestigingOp": { "type": "string", "format": "date-time" }
            }
          },
          "archief": {
            "type": "object",
            "description": "Archival record (TMLO/MDTO) populated by the ArchivalJob",
            "properties": {
              "gearchiveerdOp": { "type": "string", "format": "date-time" },
              "archiefId": { "type": "string" },
              "tmloMetadata": { "type": "object", "description": "TMLO-1.2 or MDTO metadata block" },
              "vernietigingsdatum": { "type": "string", "format": "date" }
            }
          }
        }
      },
      "stateMachineLog": {
        "slug": "stateMachineLog",
        "icon": "HistoryOutline",
        "version": "1.0.0",
        "x-schema-org-type": "schema:Action",
        "title": "State Machine Log",
        "description": "Immutable record of a single beschikking state transition, including actor, trigger, and supporting evidence (mandaat reference or TSP rapport).",
        "type": "object",
        "required": [
          "beschikkingId",
          "overgang"
        ],
        "properties": {
          "beschikkingId": {
            "type": "string",
            "description": "The beschikking this transition belongs to",
            "facetable": true
          },
          "overgang": {
            "type": "object",
            "description": "Transition details",
            "properties": {
              "van": { "type": "string", "description": "Source status" },
              "naar": { "type": "string", "description": "Target status" },
              "tijdstip": { "type": "string", "format": "date-time" },
              "actor": { "type": "string", "description": "Nextcloud UID or 'systeem'" },
              "actorType": { "type": "string", "enum": ["medewerker", "systeem"] },
              "trigger": { "type": "string", "enum": ["handmatig", "automatisch"] },
              "bewijsMateriaal": {
                "type": "object",
                "properties": {
                  "soort": { "type": "string" },
                  "rapportId": { "type": "string" }
                }
              }
            }
          }
        }
      },
      "bezwaarTrigger": {
        "slug": "bezwaarTrigger",
        "icon": "AlarmOutline",
        "version": "1.0.0",
        "x-schema-org-type": "schema:Schedule",
        "title": "Bezwaar Trigger",
        "description": "Scheduling record created when a beschikking is verzonden. Drives the daily BezwaarTermijnJob: when the bezwaartermijn lapses without a bezwaarschrift, archival is triggered.",
        "type": "object",
        "required": [
          "beschikkingId",
          "bezwaarTermijnEindDatum"
        ],
        "properties": {
          "beschikkingId": {
            "type": "string",
            "description": "The beschikking this trigger belongs to",
            "facetable": true
          },
          "bekendmakingDatum": { "type": "string", "format": "date" },
          "bezwaarTermijnEindDatum": { "type": "string", "format": "date" },
          "herinneringDatum": { "type": "string", "format": "date" },
          "bezwaarOntvangen": {
            "type": "boolean",
            "default": false,
            "description": "Whether a bezwaarschrift has been received",
            "facetable": true
          },
          "bezwaarZaakId": { "type": "string", "description": "Linked bezwaar case, if any" },
          "archiefTriggerActief": {
            "type": "boolean",
            "default": true,
            "description": "Whether the archival trigger is still active",
            "facetable": true
          },
          "archiefDatum": {
            "type": "string",
            "format": "date",
            "description": "Date on which archival becomes due"
          }
        }
      },
      "mandaatRegeling": {
        "slug": "mandaatRegeling",
        "icon": "AccountTieOutline",
        "version": "1.0.0",
        "x-schema-org-type": "schema:Legislation",
        "title": "Mandaatregeling",
        "description": "Defines which approval levels (niveau) may sign which decision types up to which bedrag (Awb 10:3-10:12). Point-in-time: the regeling-id + version is captured on the beschikking at akkoord.",
        "type": "object",
        "required": [
          "naam",
          "mandaatGroepen"
        ],
        "properties": {
          "naam": { "type": "string", "maxLength": 255 },
          "verleendDoor": { "type": "string" },
          "verleendDatum": { "type": "string", "format": "date" },
          "intrekkingsDatum": { "type": "string", "format": "date" },
          "ondermandaatToegestaan": { "type": "boolean", "default": false },
          "mandaatGroepen": {
            "type": "array",
            "description": "Authorization groups within this regeling",
            "items": {
              "type": "object",
              "properties": {
                "niveau": { "type": "string", "description": "Approval level (e.g. consulent, afdelingsmanager, directeur)" },
                "tot_bedrag": { "type": "number", "description": "Upper bedrag limit; null means unlimited" },
                "zaaktypes": { "type": "array", "items": { "type": "string" } },
                "beschikkingTypes": { "type": "array", "items": { "type": "string" } }
              }
            }
          }
        }
      }
    },
