{
    "components": {
        "schemas": {
            "portaalBericht": {
                "slug": "portaalBericht",
                "icon": "MessageOutline",
                "version": "1.0.0",
                "x-schema-org-type": "schema:Message",
                "title": "Portaal Bericht",
                "description": "A message sent by a citizen (burger/bedrijf/gemachtigde) to the case handler via the Mijn gemeente citizen portal, linked to a Procest case. Citizen identity (BSN/KvK) is a Nextcloud/DigiD session identity, never invented as a contact schema.",
                "type": "object",
                "required": [
                    "caseId",
                    "senderRef",
                    "content"
                ],
                "properties": {
                    "caseId": {
                        "type": "string",
                        "description": "Procest case id (zaakId) the message is attached to."
                    },
                    "caseReference": {
                        "type": "string",
                        "description": "Human-readable case kenmerk (e.g. Z/2026/09128)."
                    },
                    "senderType": {
                        "type": "string",
                        "enum": ["burger", "bedrijf", "gemachtigde"],
                        "description": "Type of the authenticated sender."
                    },
                    "senderRef": {
                        "type": "string",
                        "description": "Pseudonymous subject reference of the sender (BSN/KvK hash), never the raw BSN. Used for IDOR scoping."
                    },
                    "senderName": {
                        "type": "string",
                        "description": "Display name of the sender."
                    },
                    "recipientRef": {
                        "type": "string",
                        "description": "Handler/medewerker reference the message is routed to."
                    },
                    "subject": {
                        "type": "string",
                        "description": "Optional subject of the message."
                    },
                    "content": {
                        "type": "string",
                        "description": "Body of the citizen's message."
                    },
                    "attachments": {
                        "type": "array",
                        "items": {"type": "string"},
                        "description": "OpenRegister document ids attached to the message."
                    },
                    "direction": {
                        "type": "string",
                        "enum": ["citizen_to_handler", "handler_to_citizen"],
                        "description": "Direction of the message."
                    },
                    "sentAt": {
                        "type": "string",
                        "format": "date-time",
                        "description": "When the message was sent."
                    },
                    "readByRecipientAt": {
                        "type": "string",
                        "format": "date-time",
                        "description": "When the recipient read the message (null until read)."
                    }
                }
            },
            "portaalVerzoek": {
                "slug": "portaalVerzoek",
                "icon": "FileDocumentEditOutline",
                "version": "1.0.0",
                "x-schema-org-type": "schema:Action",
                "title": "Portaal Verzoek",
                "description": "A citizen-initiated request submitted via the Mijn gemeente portal: a bezwaarschrift (objection), klachtschrift (complaint) or subsidie-aanvraag. Creates a new bezwaar/klacht/subsidie case in Procest.",
                "type": "object",
                "required": [
                    "soort",
                    "submitterRef"
                ],
                "properties": {
                    "soort": {
                        "type": "string",
                        "enum": ["bezwaarschrift", "klachtschrift", "subsidie-aanvraag"],
                        "description": "Type of request."
                    },
                    "tegenZaakId": {
                        "type": "string",
                        "description": "Source case id the request contests (for bezwaar)."
                    },
                    "tegenBeschikkingId": {
                        "type": "string",
                        "description": "Decision id the objection is filed against."
                    },
                    "submitterType": {
                        "type": "string",
                        "enum": ["burger", "bedrijf", "gemachtigde"],
                        "description": "Type of the authenticated submitter."
                    },
                    "submitterRef": {
                        "type": "string",
                        "description": "Pseudonymous subject reference of the submitter (never raw BSN). Used for IDOR scoping."
                    },
                    "submitterName": {
                        "type": "string",
                        "description": "Display name of the submitter."
                    },
                    "categorie": {
                        "type": "string",
                        "description": "Category of a klacht (Bejegening, Doorlooptijd, Communicatie, Medische/Zorgkwaliteit, Andere)."
                    },
                    "onderwerp": {
                        "type": "string",
                        "description": "Subject of the request."
                    },
                    "motivering": {
                        "type": "string",
                        "description": "Reasoning / description of the request."
                    },
                    "betrokkenMedewerker": {
                        "type": "string",
                        "description": "Optional employee/department referenced in a complaint."
                    },
                    "attachments": {
                        "type": "array",
                        "items": {"type": "string"},
                        "description": "OpenRegister document ids attached to the request."
                    },
                    "submittedAt": {
                        "type": "string",
                        "format": "date-time",
                        "description": "When the request was submitted."
                    },
                    "binnenTermijn": {
                        "type": "boolean",
                        "description": "Whether the request was filed within the statutory deadline."
                    },
                    "deadline": {
                        "type": "string",
                        "format": "date",
                        "description": "The applicable statutory deadline at the moment of filing."
                    },
                    "nieuweZaakId": {
                        "type": "string",
                        "description": "Id of the new Procest case created from this request."
                    },
                    "referentie": {
                        "type": "string",
                        "description": "Citizen-facing reference number (e.g. KL-2026-00001)."
                    },
                    "status": {
                        "type": "string",
                        "enum": ["ontvangen", "in-behandeling", "afgehandeld"],
                        "description": "Processing status."
                    }
                }
            },
            "portaalNotificatieVoorkeur": {
                "slug": "portaalNotificatieVoorkeur",
                "icon": "BellCogOutline",
                "version": "1.0.0",
                "x-schema-org-type": "schema:Thing",
                "title": "Portaal Notificatie Voorkeur",
                "description": "A citizen's notification preferences for the Mijn gemeente portal. Berichtenbox is statutory and always remains active. One record per subject reference.",
                "type": "object",
                "required": [
                    "subjectRef"
                ],
                "properties": {
                    "subjectRef": {
                        "type": "string",
                        "description": "Pseudonymous subject reference (never raw BSN). One preference record per subject."
                    },
                    "emailActief": {
                        "type": "boolean",
                        "description": "Whether email notifications are active."
                    },
                    "emailAdres": {
                        "type": "string",
                        "description": "The notification email address."
                    },
                    "emailGeverifieerd": {
                        "type": "boolean",
                        "description": "Whether the email address has been verified."
                    },
                    "pendingEmailAdres": {
                        "type": "string",
                        "description": "A new, not-yet-verified email address."
                    },
                    "pendingEmailToken": {
                        "type": "string",
                        "description": "Verification token for the pending email address."
                    },
                    "pendingEmailExpiresAt": {
                        "type": "string",
                        "format": "date-time",
                        "description": "When the pending email verification expires (7 days)."
                    },
                    "berichtenboxActief": {
                        "type": "boolean",
                        "description": "Whether Berichtenbox is active. Always true (statutory)."
                    },
                    "smsActief": {
                        "type": "boolean",
                        "description": "Whether SMS notifications are active."
                    },
                    "smsNummer": {
                        "type": "string",
                        "description": "The SMS notification phone number."
                    },
                    "eventStatuswijziging": {
                        "type": "boolean",
                        "description": "Notify on case status change."
                    },
                    "eventDocumentToegevoegd": {
                        "type": "boolean",
                        "description": "Notify when a document is added."
                    },
                    "eventBerichtVanBehandelaar": {
                        "type": "boolean",
                        "description": "Notify on a reply from the handler."
                    },
                    "eventTermijnHerinnering": {
                        "type": "boolean",
                        "description": "Notify on deadline reminders."
                    }
                }
            }
        },
        "registers": {
            "procest": {
                "schemas": [
                    "portaalBericht",
                    "portaalVerzoek",
                    "portaalNotificatieVoorkeur"
                ]
            }
        },
        "objects": [
            {
                "@self": {
                    "register": "procest",
                    "schema": "portaalNotificatieVoorkeur",
                    "slug": "portaal-pref-demo-burger"
                },
                "subjectRef": "demo-burger-123456789",
                "emailActief": true,
                "emailAdres": "marja@example.nl",
                "emailGeverifieerd": true,
                "berichtenboxActief": true,
                "smsActief": false,
                "eventStatuswijziging": true,
                "eventDocumentToegevoegd": true,
                "eventBerichtVanBehandelaar": true,
                "eventTermijnHerinnering": true
            },
            {
                "@self": {
                    "register": "procest",
                    "schema": "portaalBericht",
                    "slug": "portaal-bericht-demo-1"
                },
                "caseId": "zaak-2026-vth-09128",
                "caseReference": "Z/2026/09128",
                "senderType": "burger",
                "senderRef": "demo-burger-123456789",
                "senderName": "M.A. Janssen-de Vries",
                "subject": "Vraag over voorwaarde 3 in beschikking",
                "content": "Geachte mevrouw Bakker, kunt u toelichten wat exact wordt bedoeld met 'voorgeschreven dakhellingshoek'?",
                "direction": "citizen_to_handler",
                "sentAt": "2026-04-10T14:33:00+02:00"
            }
        ]
    }
}
