        "version": "1.0.0",
        "title": "Samenwerkverzoek",
        "description": "Request for collaboration between bevoegd gezag on a vergunningaanvraag",
        "type": "object",
        "required": [
          "initiatorBevoegdGezag",
          "aangezochtBevoegdGezag",
          "vergunningaanvraagRef",
          "status"
        ],
        "properties": {
          "initiatorBevoegdGezag": {
            "type": "string",
            "description": "OIN or organization name of the initiating bevoegd gezag"
          },
          "aangezochtBevoegdGezag": {
            "type": "string",
            "description": "OIN or organization name of the receiving bevoegd gezag"
          },
          "vergunningaanvraagRef": {
            "type": "string",
            "description": "Reference to the linked vergunningaanvraag object"
          },
          "rationale": {
            "type": "string",
            "description": "Reason for requesting collaboration"
          },
          "status": {
            "type": "string",
            "enum": ["aangevraagd", "geaccepteerd", "geweigerd", "afgerond"],
            "description": "Current status of the samenwerkverzoek",
            "facetable": true
          },
          "advies": {
            "type": "string",
            "description": "Advice given by the aangezochte bevoegd gezag"
          },
          "aangevraagdOp": {
            "type": "string",
            "format": "date-time",
            "description": "Timestamp when the samenwerkverzoek was initiated"
          },
          "gereageerdOp": {
            "type": "string",
            "format": "date-time",
            "description": "Timestamp when the aangezochte bevoegd gezag responded"
          },
          "zaakId": {
            "type": "string",
            "format": "uuid",
            "description": "UUID of the linked Procest zaak"
          }
        }
      }
    },
