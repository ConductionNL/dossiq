{
  "components": {
    "schemas": {
      "fieldInspection": {
        "slug": "fieldInspection",
        "icon": "ClipboardSearchOutline",
        "version": "1.0.0",
        "x-schema-org-type": "schema:Action",
        "title": "Field Inspection",
        "description": "A planned or in-progress field inspection synchronized to an inspector's device for offline fieldwork. Extends a Procest case with offline lifecycle metadata.",
        "type": "object",
        "required": [
          "caseRef",
          "inspectorRef",
          "status"
        ],
        "properties": {
          "caseRef": {
            "type": "string",
            "description": "Reference to the Procest case this inspection belongs to"
          },
          "inspectorRef": {
            "type": "string",
            "description": "User UID of the inspector assigned to this inspection"
          },
          "scheduledAt": {
            "type": "string",
            "format": "date-time",
            "description": "Planned start date and time"
          },
          "startedAt": {
            "type": "string",
            "format": "date-time",
            "description": "Actual start date and time (set when work begins on site)"
          },
          "completedAt": {
            "type": "string",
            "format": "date-time",
            "description": "Date and time the inspection was completed"
          },
          "gpsLocation": {
            "type": "object",
            "description": "GPS coordinates captured at inspection start",
            "properties": {
              "lat": { "type": "number" },
              "lon": { "type": "number" },
              "accuracy": { "type": "number", "description": "Accuracy in meters" },
              "timestamp": { "type": "string", "format": "date-time" }
            }
          },
          "status": {
            "type": "string",
            "enum": [
              "planned",
              "in_progress",
              "synced",
              "conflict"
            ],
            "default": "planned",
            "description": "Offline lifecycle status of the inspection"
          },
          "offlineCreatedAt": {
            "type": "string",
            "format": "date-time",
            "description": "Timestamp the record was created on the offline device"
          },
          "syncedAt": {
            "type": "string",
            "format": "date-time",
            "description": "Timestamp the record was successfully synchronized to the server"
          },
          "deviceId": {
            "type": "string",
            "description": "Stable identifier of the device that owns the offline copy"
          }
        }
      },
      "checklistResult": {
        "slug": "checklistResult",
        "icon": "ClipboardCheckOutline",
        "version": "1.0.0",
        "x-schema-org-type": "schema:Report",
        "title": "Checklist Result",
        "description": "Per-item answers captured offline for a single field inspection against a checklist template.",
        "type": "object",
        "required": [
          "inspectionRef",
          "checklistTemplateRef"
        ],
        "properties": {
          "inspectionRef": {
            "type": "string",
            "description": "Reference to the fieldInspection this result belongs to"
          },
          "checklistTemplateRef": {
            "type": "string",
            "description": "Reference to the inspectionChecklist template used"
          },
          "items": {
            "type": "array",
            "description": "Per-question answers",
            "items": {
              "type": "object",
              "properties": {
                "questionId": { "type": "string" },
                "answer": { "type": "string" },
                "evidenceRefs": {
                  "type": "array",
                  "items": { "type": "string" },
                  "description": "References to fieldEvidence records for this answer"
                },
                "notes": { "type": "string" },
                "answeredAt": { "type": "string", "format": "date-time" },
                "gpsAtAnswer": {
                  "type": "object",
                  "properties": {
                    "lat": { "type": "number" },
                    "lon": { "type": "number" },
                    "accuracy": { "type": "number" },
                    "source": {
                      "type": "string",
                      "enum": ["sensor", "sensorless"],
                      "description": "Whether coordinates came from the GPS sensor or fell back to the case address"
                    }
                  }
                }
              }
            }
          }
        }
      },
      "fieldEvidence": {
        "slug": "fieldEvidence",
        "icon": "CameraOutline",
        "version": "1.0.0",
        "x-schema-org-type": "schema:MediaObject",
        "title": "Field Evidence",
        "description": "A piece of evidence (photo, voice memo, document, or sketch) captured offline during a field inspection.",
        "type": "object",
        "required": [
          "inspectionRef",
          "type"
        ],
        "properties": {
          "inspectionRef": {
            "type": "string",
            "description": "Reference to the fieldInspection this evidence belongs to"
          },
          "type": {
            "type": "string",
            "enum": [
              "photo",
              "voice_memo",
              "document",
              "sketch"
            ],
            "description": "Kind of evidence captured"
          },
          "localBlobRef": {
            "type": "string",
            "description": "IndexedDB reference to the local blob prior to upload"
          },
          "cloudUrl": {
            "type": "string",
            "description": "URL of the uploaded file once synced (nullable until upload completes)"
          },
          "gpsLocation": {
            "type": "object",
            "properties": {
              "lat": { "type": "number" },
              "lon": { "type": "number" },
              "accuracy": { "type": "number" },
              "timestamp": { "type": "string", "format": "date-time" }
            }
          },
          "capturedAt": {
            "type": "string",
            "format": "date-time"
          },
          "transcription": {
            "type": "string",
            "description": "Transcribed text for voice_memo evidence"
          },
          "transcriptionStatus": {
            "type": "string",
            "enum": [
              "pending",
              "syncing",
              "synced",
              "failed",
              "not_applicable"
            ],
            "default": "not_applicable"
          },
          "tags": {
            "type": "array",
            "items": { "type": "string" }
          },
          "sensitivityLevel": {
            "type": "string",
            "enum": [
              "public",
              "internal",
              "confidential",
              "special_category"
            ],
            "default": "internal",
            "description": "AVG/GDPR sensitivity classification of the evidence"
          }
        }
      },
      "syncQueue": {
        "slug": "syncQueue",
        "icon": "SyncOutline",
        "version": "1.0.0",
        "x-schema-org-type": "schema:Action",
        "title": "Sync Queue Operation",
        "description": "A single mutation queued offline to be replayed against OpenRegister when the device reconnects.",
        "type": "object",
        "required": [
          "deviceId",
          "operationType",
          "targetEntity",
          "status"
        ],
        "properties": {
          "deviceId": {
            "type": "string",
            "description": "Device that queued the operation"
          },
          "operationType": {
            "type": "string",
            "enum": [
              "create",
              "update",
              "upload",
              "transcribe",
              "delete"
            ]
          },
          "targetEntity": {
            "type": "string",
            "description": "Schema slug the operation targets (e.g. checklistResult, fieldEvidence)"
          },
          "targetId": {
            "type": "string",
            "description": "Identifier of the target object"
          },
          "payload": {
            "type": "object",
            "description": "Operation payload to replay"
          },
          "queuedAt": {
            "type": "string",
            "format": "date-time",
            "description": "Timestamp the operation was queued (replay ordering key)"
          },
          "attemptCount": {
            "type": "integer",
            "default": 0,
            "description": "Number of replay attempts made"
          },
          "lastAttemptAt": {
            "type": "string",
            "format": "date-time"
          },
          "lastError": {
            "type": "string",
            "description": "Last error message recorded on failure"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "syncing",
              "synced",
              "conflict",
              "failed"
            ],
            "default": "pending"
          }
        }
      },
      "conflictRecord": {
        "slug": "conflictRecord",
        "icon": "AlertOctagonOutline",
        "version": "1.0.0",
        "x-schema-org-type": "schema:Action",
        "title": "Conflict Record",
        "description": "Records a concurrent-edit, deleted-remote, or permission-lost conflict detected while replaying a queued operation, plus its resolution for AVG audit.",
        "type": "object",
        "required": [
          "syncQueueRef",
          "conflictType"
        ],
        "properties": {
          "syncQueueRef": {
            "type": "string",
            "description": "Reference to the syncQueue operation that conflicted"
          },
          "serverVersion": {
            "type": "object",
            "description": "Snapshot of the server-side object at conflict time"
          },
          "clientVersion": {
            "type": "object",
            "description": "Snapshot of the client-side (offline) object at conflict time"
          },
          "conflictType": {
            "type": "string",
            "enum": [
              "concurrent_edit",
              "deleted_remote",
              "permission_lost"
            ]
          },
          "resolution": {
            "type": "string",
            "enum": [
              "client_wins",
              "server_wins",
              "manual_merge"
            ],
            "description": "Resolution choice (null until resolved)"
          },
          "resolvedBy": {
            "type": "string",
            "description": "User UID who resolved the conflict"
          },
          "resolvedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  }
}
