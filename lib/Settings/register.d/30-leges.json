{
    "components": {
        "schemas": {
            "legesTariefTabel": {
                "slug": "legesTariefTabel",
                "icon": "FileDocumentMultipleOutline",
                "version": "1.0.0",
                "title": "Leges tarieventabel",
                "description": "Versionable container of leges tariffs per municipality and fiscal year, importable from a decidesk raadsbesluit.",
                "type": "object",
                "required": ["naam", "geldigVanaf", "status"],
                "properties": {
                    "naam": {
                        "type": "string",
                        "maxLength": 255,
                        "title": "Naam",
                        "description": "E.g. 'Legesverordening 2026'"
                    },
                    "geldigVanaf": {
                        "type": "string",
                        "format": "date",
                        "title": "Geldig vanaf",
                        "description": "Effective date of this tariff table",
                        "facetable": true
                    },
                    "geldigTotEnMet": {
                        "type": "string",
                        "format": "date",
                        "title": "Geldig tot en met",
                        "description": "Expiry date (null = open-ended)"
                    },
                    "vastgesteldDoor": {
                        "type": "string",
                        "title": "Vastgesteld door",
                        "description": "Reference to the decidesk raadsbesluit"
                    },
                    "vastgesteldOp": {
                        "type": "string",
                        "format": "date",
                        "title": "Vastgesteld op",
                        "description": "Date of the council decision"
                    },
                    "status": {
                        "type": "string",
                        "enum": ["concept", "vastgesteld", "vervallen"],
                        "title": "Status",
                        "description": "Lifecycle status of the tariff table",
                        "facetable": true
                    }
                }
            },
            "legesTarief": {
                "slug": "legesTarief",
                "icon": "CurrencyEur",
                "version": "1.0.0",
                "title": "Leges tarief",
                "description": "An individual tariff line within a leges tariff table.",
                "type": "object",
                "required": ["tariefTabelId", "tariefNummer", "omschrijving", "bedrag", "grondslag", "eenheid", "btwTarief", "grootboekrekening"],
                "properties": {
                    "tariefTabelId": {
                        "type": "string",
                        "format": "uuid",
                        "title": "Tarieventabel",
                        "description": "Parent legesTariefTabel",
                        "facetable": true
                    },
                    "tariefNummer": {
                        "type": "string",
                        "title": "Tariefnummer",
                        "description": "Hierarchical number, e.g. '2.3.1.1'",
                        "facetable": true
                    },
                    "omschrijving": {
                        "type": "string",
                        "maxLength": 1024,
                        "title": "Omschrijving",
                        "description": "E.g. 'Omgevingsvergunning bouwactiviteit'"
                    },
                    "bedrag": {
                        "type": "integer",
                        "title": "Bedrag",
                        "description": "Amount in eurocents (fixed tariff or minimum)"
                    },
                    "grondslag": {
                        "type": "string",
                        "enum": ["vast", "oppervlakte", "bouwsom", "staffel", "formule"],
                        "title": "Grondslag",
                        "description": "Calculation basis"
                    },
                    "eenheid": {
                        "type": "string",
                        "enum": ["per_stuk", "per_m2", "per_uur", "percentage"],
                        "title": "Eenheid",
                        "description": "Unit of measure"
                    },
                    "grondslagVeld": {
                        "type": "string",
                        "title": "Grondslag veld",
                        "description": "Case attribute used as the calculation base (e.g. 'bouwsom', 'oppervlakte')"
                    },
                    "percentage": {
                        "type": "number",
                        "title": "Percentage",
                        "description": "Percentage applied to the grondslag (for percentage/bouwsom basis)"
                    },
                    "staffelWaarden": {
                        "type": "array",
                        "title": "Staffelwaarden",
                        "description": "Array of {min, max, bedrag} tiers for staffel basis",
                        "items": {
                            "type": "object",
                            "properties": {
                                "min": { "type": "integer" },
                                "max": { "type": "integer" },
                                "bedrag": { "type": "integer" }
                            }
                        }
                    },
                    "btwTarief": {
                        "type": "integer",
                        "enum": [0, 9, 21],
                        "title": "BTW-tarief",
                        "description": "VAT percentage"
                    },
                    "grootboekrekening": {
                        "type": "string",
                        "title": "Grootboekrekening",
                        "description": "General ledger account, e.g. '8004050'"
                    },
                    "kostendrager": {
                        "type": "string",
                        "title": "Kostendrager",
                        "description": "Cost carrier, e.g. 'Burgerzaken'"
                    },
                    "productCode": {
                        "type": "string",
                        "title": "Productcode",
                        "description": "GEMMA product catalogue code"
                    },
                    "zaaktype": {
                        "type": "string",
                        "format": "uuid",
                        "title": "Zaaktype",
                        "description": "Case type this tariff is coupled to (drives automatic calculation)",
                        "facetable": true
                    }
                }
            },
            "legesVariant": {
                "slug": "legesVariant",
                "icon": "CallSplit",
                "version": "1.0.0",
                "title": "Leges variant",
                "description": "A sub-tariff (e.g. Tariff A vs B, regular vs express) selected on case attributes.",
                "type": "object",
                "required": ["tariefId", "variantNaam", "condities"],
                "properties": {
                    "tariefId": {
                        "type": "string",
                        "format": "uuid",
                        "title": "Tarief",
                        "description": "Parent legesTarief",
                        "facetable": true
                    },
                    "variantNaam": {
                        "type": "string",
                        "title": "Variantnaam",
                        "description": "E.g. 'Variant B: Spoed'"
                    },
                    "condities": {
                        "type": "object",
                        "title": "Condities",
                        "description": "JSON selection rules (leeftijd, oppervlakte-range, spoedAanvraag)"
                    },
                    "bedragOpslag": {
                        "type": "integer",
                        "title": "Bedrag opslag",
                        "description": "Surcharge on the parent amount (eurocents)"
                    },
                    "bedragOverride": {
                        "type": "integer",
                        "title": "Bedrag override",
                        "description": "Override of the parent amount (eurocents)"
                    }
                }
            },
            "legesKorting": {
                "slug": "legesKorting",
                "icon": "SaleOutline",
                "version": "1.0.0",
                "title": "Leges korting",
                "description": "An exemption or discount rule (65-plus, minima, repeat application) with conditions and legal basis.",
                "type": "object",
                "required": ["naam", "kortingsType", "kortingsWaarde", "condities", "geldigVanaf"],
                "properties": {
                    "naam": {
                        "type": "string",
                        "title": "Naam",
                        "description": "E.g. '65-plus vrijstelling rijbewijs'"
                    },
                    "tariefIds": {
                        "type": "array",
                        "title": "Tarief-ids",
                        "description": "Tariffs this discount applies to",
                        "items": { "type": "string", "format": "uuid" }
                    },
                    "kortingsType": {
                        "type": "string",
                        "enum": ["percentage", "vast_bedrag", "volledige_vrijstelling"],
                        "title": "Kortingstype"
                    },
                    "kortingsWaarde": {
                        "type": "number",
                        "title": "Kortingswaarde",
                        "description": "Percentage (0-100) or fixed amount in eurocents"
                    },
                    "condities": {
                        "type": "object",
                        "title": "Condities",
                        "description": "JSON rules (leeftijd, inkomen, herhaalaanvraag-maanden)"
                    },
                    "wettelijkeGrondslag": {
                        "type": "string",
                        "title": "Wettelijke grondslag",
                        "description": "E.g. 'Gemeentewet art. 229 lid 3'"
                    },
                    "vereistMinimaCheck": {
                        "type": "boolean",
                        "title": "Vereist minima-check",
                        "description": "Whether the discount requires income verification before applying"
                    },
                    "geldigVanaf": {
                        "type": "string",
                        "format": "date",
                        "title": "Geldig vanaf"
                    },
                    "geldigTotEnMet": {
                        "type": "string",
                        "format": "date",
                        "title": "Geldig tot en met"
                    }
                }
            },
            "legesBerekening": {
                "slug": "legesBerekening",
                "icon": "Calculator",
                "version": "1.0.0",
                "title": "Leges berekening",
                "description": "A concrete leges calculation for a single case, including amount, VAT, applied discounts and audit trail.",
                "type": "object",
                "required": ["zaakId", "tariefTabelId", "tariefId", "bedragExclBtw", "btwBedrag", "bedragInclBtw", "berekendeOp", "berekendDoor", "berekeningsToelichting", "status"],
                "properties": {
                    "zaakId": {
                        "type": "string",
                        "format": "uuid",
                        "title": "Zaak",
                        "description": "Parent case",
                        "facetable": true
                    },
                    "tariefTabelId": {
                        "type": "string",
                        "format": "uuid",
                        "title": "Tarieventabel",
                        "description": "Tariff table version used"
                    },
                    "tariefId": {
                        "type": "string",
                        "format": "uuid",
                        "title": "Tarief",
                        "description": "Selected tariff"
                    },
                    "variantId": {
                        "type": "string",
                        "format": "uuid",
                        "title": "Variant",
                        "description": "Selected variant (if any)"
                    },
                    "appliedKortingen": {
                        "type": "array",
                        "title": "Toegepaste kortingen",
                        "description": "Array of {kortingId, bedrag, grondslag}",
                        "items": { "type": "object" }
                    },
                    "bedragExclBtw": {
                        "type": "integer",
                        "title": "Bedrag excl. BTW",
                        "description": "Amount excluding VAT (eurocents)"
                    },
                    "btwBedrag": {
                        "type": "integer",
                        "title": "BTW-bedrag",
                        "description": "VAT amount (eurocents)"
                    },
                    "bedragInclBtw": {
                        "type": "integer",
                        "title": "Bedrag incl. BTW",
                        "description": "Total amount including VAT (eurocents)"
                    },
                    "berekendeOp": {
                        "type": "string",
                        "format": "date",
                        "title": "Peildatum",
                        "description": "Reference date used for tariff selection"
                    },
                    "berekendDoor": {
                        "type": "string",
                        "title": "Berekend door",
                        "description": "'system' or a user id"
                    },
                    "berekeningsToelichting": {
                        "type": "string",
                        "title": "Berekeningstoelichting",
                        "description": "Human-readable audit string"
                    },
                    "factuurId": {
                        "type": "string",
                        "title": "Factuur",
                        "description": "Reference to the shillinq invoice"
                    },
                    "status": {
                        "type": "string",
                        "enum": ["berekend", "pending_minima_check", "gefactureerd", "betaald", "gerestitueerd", "kwijtgescholden"],
                        "title": "Status",
                        "facetable": true
                    }
                }
            },
            "legesRestitutie": {
                "slug": "legesRestitutie",
                "icon": "CashRefund",
                "version": "1.0.0",
                "title": "Leges restitutie",
                "description": "A refund decision for a leges calculation, phase-dependent percentage with credit invoice reference.",
                "type": "object",
                "required": ["berekeningId", "restitutieReden", "fase", "restitutiePercentage", "restitutieBedrag", "besluitNemerId", "besluitDatum"],
                "properties": {
                    "berekeningId": {
                        "type": "string",
                        "format": "uuid",
                        "title": "Berekening",
                        "description": "Parent legesBerekening",
                        "facetable": true
                    },
                    "restitutieReden": {
                        "type": "string",
                        "enum": ["aanvraag_ingetrokken", "dubbel_betaald", "coulance", "bezwaar_gegrond"],
                        "title": "Restitutiereden"
                    },
                    "fase": {
                        "type": "string",
                        "title": "Fase",
                        "description": "Phase in which the case was withdrawn"
                    },
                    "restitutiePercentage": {
                        "type": "integer",
                        "title": "Restitutiepercentage",
                        "description": "Staffel percentage (0-100) based on phase"
                    },
                    "restitutieBedrag": {
                        "type": "integer",
                        "title": "Restitutiebedrag",
                        "description": "Amount to refund (eurocents)"
                    },
                    "creditfactuurId": {
                        "type": "string",
                        "title": "Creditfactuur",
                        "description": "Reference to the shillinq credit invoice"
                    },
                    "besluitNemerId": {
                        "type": "string",
                        "title": "Besluitnemer",
                        "description": "User who granted the refund"
                    },
                    "besluitDatum": {
                        "type": "string",
                        "format": "date",
                        "title": "Besluitdatum"
                    }
                }
            }
        }
    }
}
