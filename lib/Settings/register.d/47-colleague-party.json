                    },
                    "displayName": {
                        "type": "string",
                        "title": "Name",
                        "description": "The colleague's name as shown on the case.",
                        "maxLength": 255
                    },
                    "email": {
                        "type": "string",
                        "format": "email",
                        "title": "Email",
                        "description": "The colleague's work e-mail address."
                    },
                    "jobTitle": {
                        "type": "string",
                        "title": "Job title",
                        "description": "The colleague's job, such as tree expert or legal adviser.",
                        "maxLength": 255
                    },
                    "department": {
                        "type": "string",
                        "title": "Department",
                        "description": "The team or department the colleague works in.",
                        "maxLength": 255
                    }
                },
                "configuration": {
                    "x-openregister-party": { "kind": "colleague", "nameProperty": "displayName" },
                    "objectNameField": "displayName",
                    "objectDescriptionField": "jobTitle"
                }
            }
        }
    }
