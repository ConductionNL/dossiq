{
  "_meta": {
    "_spec": "openspec/changes/consultation-management/tasks.md#TASK-CN-01",
    "_description": "Consultation (adviesaanvraag) schema fragment. Adds consultation, adviceResponse, and advisoryBody schemas so ConsultationService can find them via consultation_schema/advice_response_schema/advisory_body_schema config keys."
  },
  "components": {
    "registers": {
      "procest": {
        "schemas": [
          "consultation",
          "adviceResponse",
          "advisoryBody"
        ]
      }
    },
    "schemas": {
      "consultation": {
        "slug": "consultation",
        "icon": "ChatQuestionOutline",
        "version": "1.0.0",
        "x-schema-org-type": "schema:Action",
        "title": "Consultation",
        "description": "An advisory consultation linked to a parent case. Tracks status, deadline, dependencies, and the advisory body being consulted. Drives ConsultationService and the Awb advisory workflow.",
        "type": "object",
        "required": [
          "case",
          "type",
          "status"
        ],
        "properties": {
          "case": {
            "type": "string",
            "format": "uuid",
            "description": "Reference to the parent case",
            "facetable": true
          },
          "type": {
            "type": "string",
            "maxLength": 128,
            "description": "Consultation type slug (e.g. welstand, brandweer, monumenten)",
            "facetable": true
          },
          "advisoryBody": {
            "type": "string",
            "format": "uuid",
            "description": "Reference to the advisoryBody fielding the consultation"
          },
          "status": {
            "type": "string",
            "enum": [
              "open",
              "ontvangen",
              "in_behandeling",
              "advies_uitgebracht",
              "afgesloten",
              "ingetrokken"
            ],
            "description": "Lifecycle status",
            "facetable": true
          },
          "deadline": {
            "type": "string",
            "format": "date",
            "description": "Deadline for the advice"
          },
          "extendedDeadline": {
            "type": "string",
            "format": "date",
            "description": "Extended deadline (when verdaging is applied)"
          },
          "requestedAt": {
            "type": "string",
            "format": "date-time",
            "description": "When the consultation was created"
          },
          "respondedAt": {
            "type": "string",
            "format": "date-time",
            "description": "When advice was returned"
          },
          "publicToken": {
            "type": "string",
            "maxLength": 128,
            "description": "256-bit token for external advisory-body access (ISecureRandom-issued)"
          },
          "dependsOn": {
            "type": "array",
            "items": { "type": "string", "format": "uuid" },
            "description": "Consultation IDs that must complete before this one"
          },
          "notes": {
            "type": "string",
            "maxLength": 4096,
            "description": "Free-form notes / context"
          }
        }
      },
      "adviceResponse": {
        "slug": "adviceResponse",
        "icon": "MessageReplyOutline",
        "version": "1.0.0",
        "x-schema-org-type": "schema:Comment",
        "title": "Advice Response",
        "description": "A structured response to a consultation: advice content, conditions (voorwaarden), and advisor identity.",
        "type": "object",
        "required": [
          "consultation",
          "advisor",
          "advice"
        ],
        "properties": {
          "consultation": {
            "type": "string",
            "format": "uuid",
            "description": "Reference to the parent consultation",
            "facetable": true
          },
          "advisor": {
            "type": "string",
            "maxLength": 128,
            "description": "Identifier of the advisor (user UID or external advisory body name)"
          },
          "advice": {
            "type": "string",
            "enum": [
              "akkoord",
              "akkoord_onder_voorwaarden",
              "niet_akkoord",
              "geen_oordeel"
            ],
            "description": "The advisory verdict"
          },
          "voorwaarden": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Conditions attached to a 'akkoord onder voorwaarden' verdict"
          },
          "motivation": {
            "type": "string",
            "maxLength": 8192,
            "description": "Substantive motivation"
          },
          "submittedAt": {
            "type": "string",
            "format": "date-time",
            "description": "When the response was submitted"
          },
          "documentRefs": {
            "type": "array",
            "items": { "type": "string", "format": "uuid" },
            "description": "References to supporting documents (Nextcloud file IDs)"
          }
        }
      },
      "advisoryBody": {
        "slug": "advisoryBody",
        "icon": "AccountGroupOutline",
        "version": "1.0.0",
        "x-schema-org-type": "schema:Organization",
        "title": "Advisory Body",
        "description": "An internal or external organisation that fields consultations. Internal bodies map to NC groups; external bodies use email + secure-token access.",
        "type": "object",
        "required": [
          "name",
          "kind"
        ],
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 255,
            "description": "Display name (e.g. 'Welstandscommissie', 'Brandweer Veiligheidsregio Utrecht')",
            "facetable": true
          },
          "kind": {
            "type": "string",
            "enum": [
              "internal",
              "external"
            ],
            "description": "Internal (NC group) or external (email-based)",
            "facetable": true
          },
          "specializations": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Tags describing the body's expertise (welstand, brandveiligheid, monumenten, ...)"
          },
          "internalGroupId": {
            "type": "string",
            "maxLength": 64,
            "description": "NC group ID (internal bodies only)"
          },
          "externalEmail": {
            "type": "string",
            "format": "email",
            "description": "Contact e-mail (external bodies only)"
          },
          "defaultDeadlineOffset": {
            "type": "string",
            "description": "ISO 8601 duration default deadline offset (e.g. P28D)"
          },
          "active": {
            "type": "boolean",
            "default": true,
            "description": "Whether the body is currently accepting consultations",
            "facetable": true
          }
        }
      }
    }
  }
}
