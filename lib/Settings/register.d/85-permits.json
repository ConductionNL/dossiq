{
  "_note": "portal-permits-as-held-products D1. A permit a resident holds, as portaliq's products collection reads it (kind products, theme parkeren), and issuesPermit on the case type that grants it. Seeds the two parking case types. Issuing (D2) waits on Q-dossiq-L2-4.",
  "components": {
    "registers": {
      "dossiq": {
        "schemas": [
          "permit"
        ]
      }
    },
    "schemas": {
      "permit": {
        "slug": "permit",
        "title": "Permit",
        "version": "1.0.0",
        "description": "A permit a resident holds, issued from a decided case: what it is, for whom, from when until when, and the plate and address enforcement reads.",
        "required": [
          "title",
          "kind",
          "portalSubject"
        ],
        "properties": {
          "title": {
            "type": "string",
            "title": "Title",
            "description": "What the permit is called, as the holder reads it."
          },
          "kind": {
            "type": "string",
            "enum": [
              "parkeren-bewoner",
              "parkeren-bezoeker",
              "parkeren-bedrijf"
            ],
            "title": "Permit kind",
            "description": "Which kind of permit this is."
          },
          "theme": {
            "type": "string",
            "title": "Theme",
            "description": "The portal theme the permit is shown under, for example parkeren."
          },
          "portalSubject": {
            "type": "string",
            "visible": false,
            "title": "Holder",
            "description": "The portal subject reference of the resident who holds the permit."
          },
          "case": {
            "type": "string",
            "format": "uuid",
            "title": "Case",
            "description": "The case the permit was issued from."
          },
          "decision": {
            "type": "string",
            "format": "uuid",
            "title": "Decision",
            "description": "The decision the permit was issued under."
          },
          "validFrom": {
            "type": "string",
            "format": "date",
            "title": "Valid from",
            "description": "The first day the permit is valid."
          },
          "validUntil": {
            "type": "string",
            "format": "date",
            "title": "Valid until",
            "description": "The last day the permit is valid."
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "suspended",
              "revoked"
            ],
            "default": "active",
            "title": "Status",
            "description": "Whether the permit is in force, suspended or revoked."
          },
          "kenteken": {
            "type": "string",
            "pattern": "^[A-Z0-9]{6}$",
            "title": "Licence plate",
            "description": "The licence plate the permit is for, stored without dashes."
          },
          "adres": {
            "type": "string",
            "title": "Address",
            "description": "The address the permit belongs to."
          }
        }
      },
      "caseType": {
        "properties": {
          "issuesPermit": {
            "type": "object",
            "title": "Issues a permit",
            "description": "When a case of this type is granted, the permit the resident then holds.",
            "properties": {
              "kind": {
                "type": "string",
                "title": "Permit kind",
                "description": "Which kind of permit a granted case issues."
              },
              "theme": {
                "type": "string",
                "title": "Theme",
                "description": "The portal theme the permit is shown under."
              },
              "titleTemplate": {
                "type": "string",
                "title": "Title template",
                "description": "The permit title, with case fields in double braces."
              },
              "detailsFromCase": {
                "type": "object",
                "title": "Details from the case",
                "description": "Which case property fills each permit field, for example kenteken."
              },
              "changeCaseType": {
                "type": "string",
                "format": "uuid",
                "title": "Change case type",
                "description": "The case type a request to change the permit opens."
              },
              "changesPlateOf": {
                "type": "string",
                "title": "Changes the plate of",
                "description": "Set on a change case type: the case changes the licence plate of the permit it names."
              }
            }
          }
        }
      }
    },
