			"name": "0. Setup",
			"item": [
				{
					"name": "Preflight: resolve register by slug (CI-durable)",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"// SLUG-RESOLUTION PREFLIGHT (GAP-2): the numeric OpenRegister register id",
									"// that holds procest objects varies between environments (dev box = 17, a",
									"// fresh CI boot re-imports the register by slug and gets a different id). The",
									"// dossiq repair step re-imports its register with the stable slug 'procest',",
									"// so resolve the numeric id from the slug here and set the {{register}} var.",
									"// Every request below addresses objects as /objects/{{register}}/{{schema}}.",
									"pm.test('registers list reachable (200)', () => pm.response.to.have.status(200));",
									"const body = pm.response.json();",
									"const registers = Array.isArray(body) ? body : (body.results || []);",
									"pm.expect(registers.length, 'at least one register').to.be.above(0);",
									"const reg = registers.find(r => r.slug === 'procest');",
									"pm.test('procest register resolved by slug', () => pm.expect(reg, \"register with slug 'procest' exists\").to.be.an('object'));",
									"if (reg) {",
									"    pm.collectionVariables.set('register', String(reg.id));",
									"    console.log('Resolved register slug=procest -> id=' + reg.id);",
									"}",
									"// Case + complaint schemas are addressed by their stable slugs (the OR object",
									"// router resolves a slug against the register), so they survive re-import too.",
									"pm.collectionVariables.set('caseSchema', 'case');",
									"pm.collectionVariables.set('complaintSchema', 'complaint');"
								]
							}
						}
					],
					"request": {
						"auth": {
							"type": "basic",
							"basic": [
								{
									"key": "username",
									"value": "{{adminUser}}",
									"type": "string"
								},
								{
									"key": "password",
									"value": "{{adminPass}}",
									"type": "string"
								}
							]
						},
						"method": "GET",
						"header": [
							{
								"key": "OCS-APIRequest",
								"value": "true"
							},
							{
								"key": "Accept",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/index.php/apps/openregister/api/registers?_limit=200",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"index.php",
								"apps",
								"openregister",
								"api",
								"registers"
							],
							"query": [
								{
									"key": "_limit",
									"value": "200"
								}
							]
