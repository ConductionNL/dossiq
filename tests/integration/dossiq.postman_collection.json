				{
					"name": "Discover workflow template (caseType + transitions)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Setup: workflow templates retrieved (200)', () => pm.response.to.have.status(200));",
									"const body = pm.response.json();",
									"const results = body.results || [];",
									"pm.expect(results.length, 'at least one workflow template seeded in dev').to.be.above(0);",
									"let chosen = null;",
									"for (const t of results) {",
									"  const trans = t.transitions || [];",
									"  if (trans.length >= 2 && trans.some(x => (x.guards||[]).length > 0)) { chosen = t; break; }",
									"}",
									"if (chosen === null) { chosen = results.find(t => (t.transitions||[]).length >= 1) || results[0]; }",
									"const trans = chosen.transitions || [];",
									"pm.expect(trans.length, 'chosen template has transitions').to.be.above(0);",
									"const start = trans.find(x => (x.guards||[]).length === 0) || trans[0];",
									"const guarded = trans.find(x => (x.guards||[]).length > 0) || trans[trans.length - 1];",
									"pm.collectionVariables.set('caseTypeId', String(chosen.caseType));",
									"pm.collectionVariables.set('startStatusId', String(start.fromStatus));",
									"pm.collectionVariables.set('startTransitionId', String(start.id));",
									"pm.collectionVariables.set('midStatusId', String(guarded.fromStatus));",
									"pm.collectionVariables.set('guardTransitionId', String(guarded.id));"
								],
								"type": "text/javascript"
							}
						}
					],
