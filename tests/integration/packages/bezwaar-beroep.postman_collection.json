    },
    {
      "name": "bezwaar: flow",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/index.php/apps/openregister/api/objects/dossiq/workflowTemplate/97702755-9b9d-5859-bacc-208b693afe45"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('row is there (200)', () => pm.response.to.have.status(200));",
              "const row = pm.response.json();",
              "pm.test('belongs to the case type and is live', () => { pm.expect(row.caseType).to.eql('b3c1a000-0000-4000-a000-00000000be2a'); pm.expect(row.isActive).to.eql(true); pm.expect(row.lifecycleStatus).to.eql('published'); });",
              "const statuses = [\"b3c1a000-0000-4000-a000-0000000b2a07\", \"b3c1a000-0000-4000-a000-0000000b2a08\", \"b3c1a000-0000-4000-a000-0000000b2a06\", \"b3c1a000-0000-4000-a000-0000000b2a03\", \"b3c1a000-0000-4000-a000-0000000b2a05\", \"b3c1a000-0000-4000-a000-0000000b2a01\", \"b3c1a000-0000-4000-a000-0000000b2a10\", \"b3c1a000-0000-4000-a000-0000000b2a04\", \"b3c1a000-0000-4000-a000-0000000b2a09\", \"b3c1a000-0000-4000-a000-0000000b2a02\"];",
              "const transitions = typeof row.transitions === 'string' ? JSON.parse(row.transitions) : row.transitions;",
              "pm.test('17 transitions, each between two statuses of this case type', () => {",
              "    pm.expect(transitions.length).to.eql(17);",
              "    transitions.forEach(t => { pm.expect(statuses).to.include(t.fromStatus); pm.expect(statuses).to.include(t.toStatus); });",
              "});"
            ]
          }
        }
      ]
    },
