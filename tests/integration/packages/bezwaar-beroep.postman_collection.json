{
  "info": {
    "name": "dossiq package: bezwaar-beroep",
    "description": "Reads every kind of row the bezwaar-beroep package writes back through the OpenRegister objects API, after the packages workflow installed it on a clean instance (hydra ADR-118). Ids are the fixed ids in lib/Settings/packages/bezwaar-beroep/.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "basic",
    "basic": [
      {
        "key": "username",
        "value": "{{adminUser}}",
        "type": "string"
      },
      {
        "key": "password",
        "value": "{{adminPass}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "adminUser",
      "value": "admin"
    },
    {
      "key": "adminPass",
      "value": "admin"
    }
  ],
  "item": [
    {
      "name": "case type bezwaar",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/index.php/apps/openregister/api/objects/dossiq/caseType/b3c1a000-0000-4000-a000-00000000be2a"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('row is there (200)', () => pm.response.to.have.status(200));",
              "const row = pm.response.json();",
              "pm.test('title as shipped', () => pm.expect(row.title).to.eql(\"Bezwaar\"));",
              "pm.test('identifier as shipped', () => pm.expect(row.identifier).to.eql(\"bezwaar\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "bezwaar: first status",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/index.php/apps/openregister/api/objects/dossiq/statusType/b3c1a000-0000-4000-a000-0000000b2a01"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('row is there (200)', () => pm.response.to.have.status(200));",
              "const row = pm.response.json();",
              "pm.test('points at the case type', () => pm.expect(row.caseType).to.eql('b3c1a000-0000-4000-a000-00000000be2a'));",
              "pm.test('name and order as shipped', () => { pm.expect(row.name).to.eql(\"Ontvangen\"); pm.expect(row.order).to.eql(1); });"
            ]
          }
        }
      ]
    },
    {
      "name": "bezwaar: final status",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/index.php/apps/openregister/api/objects/dossiq/statusType/b3c1a000-0000-4000-a000-0000000b2a08"
      },
      "event": [
        {
          "listen": "test",
