    {
      "name": "ledger records the package",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/index.php/apps/openregister/api/objects/dossiq/shippedOrigin?targetObject=b3c1a000-0000-4000-a000-0000000005ab&_limit=5"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('ledger reachable (200)', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "const rows = Array.isArray(body) ? body : (body.results || []);",
              "const row = rows.find(r => r.targetObject === 'b3c1a000-0000-4000-a000-0000000005ab');",
              "pm.test('a ledger row names the package and its version', () => {",
              "    pm.expect(row, 'ledger row for the case type').to.be.an('object');",
              "    pm.expect(row.set).to.eql('subsidie');",
              "    pm.expect(row.setVersion).to.eql('1.0.0');",
              "});"
            ]
          }
        }
      ]
