      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('case is written (200/201)', () => pm.expect(pm.response.code).to.be.oneOf([200, 201]));",
              "const unwrap = (b) => (b && (b.id || b['@self'] || b.uuid)) ? b : ((b && b.results && !Array.isArray(b.results)) ? b.results : ((b && b.object) || b));",
              "const idOf = (o) => String((o && o['@self'] && o['@self'].id) || (o && o.uuid) || (o && o.id) || '');",
              "const id = idOf(unwrap(pm.response.json()));",
              "pm.test('case has an id', () => pm.expect(id).to.not.eql(''));",
              "pm.collectionVariables.set('grantCaseId', id);"
            ]
          }
        }
      ]
    },
