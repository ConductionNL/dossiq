{
  "info": {
    "name": "dossiq package: subsidie",
    "description": "Reads every kind of row the subsidie package writes back through the OpenRegister objects API, after the packages workflow installed it on a clean instance (hydra ADR-118). Ids are the fixed ids in lib/Settings/packages/subsidie/. Written by scripts/packages/package-to-newman.py. The grant chain requests after the read-backs are hand-written (openspec change grant-cases-from-application-to-settlement task 3.2): they seed a subsidie case with its application, decision and execution, record and assess an interim report, settle lower than granted and read back the proposed recovery, through dossiq's grant routes (REQ-SUB-CASE-01).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "basic",
    "basic": [
      {
        "key": "username",
        "value": "{{adminUser}}",
        "type": "string"
      },
      {
        "key": "password",
        "value": "{{adminPass}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "adminUser",
      "value": "admin"
    },
    {
      "key": "adminPass",
      "value": "admin"
    }
  ],
  "item": [
