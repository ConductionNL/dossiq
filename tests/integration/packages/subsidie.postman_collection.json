          "raw": "{\"title\": \"Newman grant chain\", \"caseType\": \"b3c1a000-0000-4000-a000-0000000005ab\", \"identifier\": \"NEWMAN-GRANT-{{$timestamp}}\", \"impact\": \"medium\", \"urgency\": \"medium\", \"intakeChannel\": \"manual\"}",
