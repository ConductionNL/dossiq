{
  "info": {
    "name": "dossiq package: subsidie",
    "description": "Reads every kind of row the subsidie package writes back through the OpenRegister objects API, after the packages workflow installed it on a clean instance (hydra ADR-118). Ids are the fixed ids in lib/Settings/packages/subsidie/. Written by scripts/packages/package-to-newman.py.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "basic",
    "basic": [
      {
        "key": "username",
        "value": "{{adminUser}}",
        "type": "string"
      },
      {
        "key": "password",
        "value": "{{adminPass}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "adminUser",
      "value": "admin"
    },
    {
      "key": "adminPass",
      "value": "admin"
    }
  ],
  "item": [
    {
      "name": "case type subsidie",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/index.php/apps/openregister/api/objects/dossiq/caseType/b3c1a000-0000-4000-a000-0000000005ab"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('row is there (200)', () => pm.response.to.have.status(200));",
              "const row = pm.response.json();",
              "pm.test('title as shipped', () => pm.expect(row.title).to.eql(\"Subsidie\"));",
              "pm.test('identifier as shipped', () => pm.expect(row.identifier).to.eql(\"subsidie\"));",
              "pm.test('processingDeadline as shipped', () => pm.expect(row.processingDeadline).to.eql(\"P13W\"));",
              "pm.test('confidentiality as shipped', () => pm.expect(row.confidentiality).to.eql(\"zaakvertrouwelijk\"));",
              "pm.test('publicationRequired as shipped', () => pm.expect(row.publicationRequired).to.eql(false));"
            ]
          }
        }
      ]
    },
    {
