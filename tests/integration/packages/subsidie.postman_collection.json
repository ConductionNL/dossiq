        "url": "{{baseUrl}}/index.php/apps/openregister/api/objects/dossiq/terugvordering/{{grantRecoveryId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('terugvordering is stored (200)', () => pm.response.to.have.status(200));",
              "const unwrap = (b) => (b && (b.id || b['@self'] || b.uuid)) ? b : ((b && b.results && !Array.isArray(b.results)) ? b.results : ((b && b.object) || b));",
              "const row = unwrap(pm.response.json());",
              "pm.test('the recovery is the advances above the settled amount', () => pm.expect(Number(row.amount)).to.eql(5000));",
              "pm.test('the recovery is proposed, not imposed', () => pm.expect(row.status).to.eql('draft'));",
              "pm.test('the recovery is on this grant', () => pm.expect(row.subsidieuitvoering).to.eql(pm.collectionVariables.get('grantExecutionId')));"
            ]
          }
        }
      ]
    },
    {
      "name": "grant chain: the case reads its settlement",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "OCS-APIRequest",
            "value": "true"
          }
        ],
        "url": "{{baseUrl}}/index.php/apps/dossiq/api/cases/{{grantCaseId}}/settlements"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('the settlements of the case (200)', () => pm.response.to.have.status(200));",
              "const rows = pm.response.json().settlements || [];",
              "const row = rows.find(r => r.id === pm.collectionVariables.get('grantDeterminationId'));",
              "pm.test('the settlement shows on the case', () => pm.expect(row).to.be.an('object'));",
              "pm.test('the case reads the settled amount', () => pm.expect(row.determinedAmount).to.eql(35000));",
              "pm.test('the case reads that a recovery follows', () => pm.expect(row.recovery).to.eql(true));",
              "pm.test('the settlement is determined', () => pm.expect(row.status).to.eql('determined'));"
            ]
          }
        }
      ]
    },
    {
      "name": "ledger records the package",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/index.php/apps/openregister/api/objects/dossiq/shippedOrigin?targetObject=b3c1a000-0000-4000-a000-0000000005ab&_limit=5"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('ledger reachable (200)', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "const rows = Array.isArray(body) ? body : (body.results || []);",
              "const row = rows.find(r => r.targetObject === 'b3c1a000-0000-4000-a000-0000000005ab');",
              "pm.test('a ledger row names the package and its version', () => {",
              "    pm.expect(row, 'ledger row for the case type').to.be.an('object');",
              "    pm.expect(row.set).to.eql('subsidie');",
              "    pm.expect(row.setVersion).to.eql(pm.variables.get('packageVersion'));",
              "});"
            ]
          }
        }
      ]
