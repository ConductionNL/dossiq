    },
    {
      "key": "adminPass",
      "value": "admin"
    }
  ],
  "item": [
    {
      "name": "case type bvw-college-besluit",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/index.php/apps/openregister/api/objects/dossiq/caseType/b77b9918-c244-5f7e-9de2-6ea34e931fcd"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('row is there (200)', () => pm.response.to.have.status(200));",
              "const row = pm.response.json();",
              "pm.test('title as shipped', () => pm.expect(row.title).to.eql(\"College-besluit\"));",
              "pm.test('identifier as shipped', () => pm.expect(row.identifier).to.eql(\"bvw-college-besluit\"));",
              "pm.test('processingDeadline as shipped', () => pm.expect(row.processingDeadline).to.eql(\"P30D\"));",
              "pm.test('confidentiality as shipped', () => pm.expect(row.confidentiality).to.eql(\"openbaar\"));",
              "pm.test('publicationRequired as shipped', () => pm.expect(row.publicationRequired).to.eql(true));"
            ]
          }
        }
      ]
