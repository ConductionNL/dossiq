{
  "info": {
    "name": "dossiq package: lhs-intervention",
    "description": "Reads the LHS intervention decision table back through the OpenRegister objects API, after the packages workflow installed the lhs-intervention package on a clean instance (hydra ADR-118). Ids are the fixed ids in lib/Settings/packages/lhs-intervention/.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "basic",
    "basic": [
      {
        "key": "username",
        "value": "{{adminUser}}",
        "type": "string"
      },
      {
        "key": "password",
        "value": "{{adminPass}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "adminUser",
      "value": "admin"
    },
    {
      "key": "adminPass",
      "value": "admin"
    },
    {
      "key": "lhsCaseId",
      "value": ""
    },
    {
      "key": "lhsAdviceId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "the intervention table",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/index.php/apps/openregister/api/objects/decision-tables/decision-table/922ad0a8-e191-5c05-a4f4-5b6aa00bbd3d"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('row is there (200)', () => pm.response.to.have.status(200));",
              "const row = pm.response.json();",
              "pm.test('key as shipped', () => pm.expect(row.key).to.eql(\"dossiq.lhs-intervention\"));",
              "pm.test('name as shipped', () => pm.expect(row.name).to.eql(\"LHS interventie (gedrag x gevolg)\"));",
              "pm.test('hitPolicy as shipped', () => pm.expect(row.hitPolicy).to.eql(\"UNIQUE\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "the table has its 16 rules",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/index.php/apps/openregister/api/objects/decision-tables/decision-table/922ad0a8-e191-5c05-a4f4-5b6aa00bbd3d"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('row is there (200)', () => pm.response.to.have.status(200));",
              "const table = pm.response.json();",
              "pm.test('16 rules', () => pm.expect(table.rules).to.have.lengthOf(16));",
              "pm.test('two inputs and two outputs', () => {",
              "    pm.expect(table.inputs.map(i => i.name)).to.eql(['behaviour', 'consequence']);",
              "    pm.expect(table.outputs.map(o => o.name)).to.eql(['interventionStep', 'description']);",
              "});",
              "pm.collectionVariables.set('lhsTableRules', JSON.stringify(table.rules));"
            ]
          }
        }
      ]
    },
    {
      "name": "the table answers what each grid cell says (decision 213)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/index.php/apps/openregister/api/objects/dossiq/lhsMatrixCell?_limit=100"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('list reachable (200)', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "const rows = Array.isArray(body) ? body : (body.results || []);",
              "const rules = JSON.parse(pm.collectionVariables.get('lhsTableRules') || '[]');",
              "pm.test('16 grid cells to compare with', () => pm.expect(rows).to.have.lengthOf(16));",
              "const different = [];",
              "for (const cell of rows) {",
              "    const hits = rules.filter(r => r.inputEntries[0] === cell.behaviourRow && r.inputEntries[1] === cell.consequenceColumn);",
              "    const same = hits.length === 1 && hits[0].outputEntries[0] === cell.interventionStep && hits[0].outputEntries[1] === (cell.description || '');",
              "    if (same === false) { different.push(`${cell.behaviourRow}:${cell.consequenceColumn}`); }",
              "}",
              "pm.test('no position where the table and the grid differ', () => pm.expect(different).to.eql([]));"
            ]
          }
        }
      ]
    },
    {
      "name": "one table under the key",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/index.php/apps/openregister/api/objects/decision-tables/decision-table?key=dossiq.lhs-intervention&_limit=10"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('list reachable (200)', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "const rows = Array.isArray(body) ? body : (body.results || []);",
              "pm.test('exactly one table has the key', () => pm.expect(rows.filter(r => r.key === 'dossiq.lhs-intervention')).to.have.lengthOf(1));"
            ]
          }
        }
      ]
    },
    {
      "name": "ledger records the package version",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/index.php/apps/openregister/api/objects/dossiq/shippedOrigin?targetSchema=package&targetObject=lhs-intervention&_limit=5"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('list reachable (200)', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "const rows = Array.isArray(body) ? body : (body.results || []);",
              "const records = rows.filter(r => r.targetSchema === 'package' && r.targetObject === 'lhs-intervention');",
              "pm.test('one version record names the package at the version it declares', () => {",
              "    pm.expect(records).to.have.lengthOf(1);",
              "    pm.expect(records[0].set).to.eql('lhs-intervention');",
              "    pm.expect(records[0].setVersion).to.eql(pm.variables.get('packageVersion'));",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "advice on a case: a handhavingszaak",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "OCS-APIRequest",
            "value": "true"
          }
        ],
        "url": "{{baseUrl}}/index.php/apps/openregister/api/objects/dossiq/case",
        "body": {
          "mode": "raw",
          "raw": "{\"title\": \"Newman LHS advice\", \"caseType\": \"9e4fe525-6aac-525c-978e-c3d74bc0213d\", \"identifier\": \"NEWMAN-LHS-{{$timestamp}}\", \"impact\": \"medium\", \"urgency\": \"medium\", \"intakeChannel\": \"manual\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('case is written (200/201)', () => pm.expect(pm.response.code).to.be.oneOf([200, 201]));",
              "const unwrap = (b) => (b && (b.id || b['@self'] || b.uuid)) ? b : ((b && b.results && !Array.isArray(b.results)) ? b.results : ((b && b.object) || b));",
              "const idOf = (o) => String((o && o['@self'] && o['@self'].id) || (o && o.uuid) || (o && o.id) || '');",
              "const id = idOf(unwrap(pm.response.json()));",
              "pm.test('case has an id', () => pm.expect(id).to.not.eql(''));",
              "pm.collectionVariables.set('lhsCaseId', id);"
            ]
          }
        }
      ]
    },
    {
      "name": "advice on a case: the form names the intervention table",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "OCS-APIRequest",
            "value": "true"
          }
        ],
        "url": "{{baseUrl}}/index.php/apps/dossiq/api/decision-advice/case/{{lhsCaseId}}/form"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('the form (200)', () => pm.response.to.have.status(200));",
              "const form = pm.response.json();",
              "pm.test('advice is available', () => pm.expect(form.available).to.eql(true));",
              "pm.test('the case type names the intervention table', () => pm.expect(form.decisionTable).to.eql('dossiq.lhs-intervention'));",
              "pm.test('the table asks behaviour and consequence', () => pm.expect(form.inputs.map(i => i.name)).to.eql(['behaviour', 'consequence']));",
              "pm.test('Waarschuwen is an outcome', () => pm.expect(form.outcomes).to.include('Waarschuwen'));"
            ]
          }
        }
      ]
    },
    {
      "name": "advice on a case: recommend",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "OCS-APIRequest",
            "value": "true"
          }
        ],
        "url": "{{baseUrl}}/index.php/apps/dossiq/api/decision-advice/recommend",
        "body": {
          "mode": "raw",
          "raw": "{\"caseId\": \"{{lhsCaseId}}\", \"inputs\": {\"behaviour\": \"A\", \"consequence\": \"2\"}}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('advice is stored (200)', () => pm.response.to.have.status(200));",
              "const unwrap = (b) => (b && (b.id || b['@self'] || b.uuid)) ? b : ((b && b.results && !Array.isArray(b.results)) ? b.results : ((b && b.object) || b));",
              "const idOf = (o) => String((o && o['@self'] && o['@self'].id) || (o && o.uuid) || (o && o.id) || '');",
              "const advice = unwrap(pm.response.json());",
              "pm.test('cell A:2 advises Waarschuwen', () => pm.expect(advice.recommendation).to.eql('Waarschuwen'));",
              "pm.test('the advice is on the case', () => pm.expect(advice.case).to.eql(pm.collectionVariables.get('lhsCaseId')));",
              "pm.test('nothing is decided yet', () => pm.expect(advice.outcome || '').to.eql(''));",
              "const id = idOf(advice);",
              "pm.test('advice has an id', () => pm.expect(id).to.not.eql(''));",
              "pm.collectionVariables.set('lhsAdviceId', id);"
            ]
          }
        }
      ]
    },
    {
      "name": "advice on a case: another outcome without a reason is refused",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "OCS-APIRequest",
            "value": "true"
          }
        ],
        "url": "{{baseUrl}}/index.php/apps/dossiq/api/decision-advice/override",
        "body": {
          "mode": "raw",
          "raw": "{\"adviceId\": \"{{lhsAdviceId}}\", \"outcome\": \"Aanspreken / informeren\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('refused (400)', () => pm.response.to.have.status(400));",
              "pm.test('the refusal asks for a reason', () => pm.expect(pm.response.json().error).to.eql('Geef een reden voor de afwijking'));"
            ]
          }
        }
      ]
    },
    {
      "name": "advice on a case: override with a reason",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "OCS-APIRequest",
            "value": "true"
          }
        ],
        "url": "{{baseUrl}}/index.php/apps/dossiq/api/decision-advice/override",
        "body": {
          "mode": "raw",
          "raw": "{\"adviceId\": \"{{lhsAdviceId}}\", \"outcome\": \"Aanspreken / informeren\", \"reason\": \"Eerste overtreding, direct hersteld.\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('the choice is stored (200)', () => pm.response.to.have.status(200));",
              "const unwrap = (b) => (b && (b.id || b['@self'] || b.uuid)) ? b : ((b && b.results && !Array.isArray(b.results)) ? b.results : ((b && b.object) || b));",
              "const idOf = (o) => String((o && o['@self'] && o['@self'].id) || (o && o.uuid) || (o && o.id) || '');",
              "const advice = unwrap(pm.response.json());",
              "pm.test('the chosen outcome', () => pm.expect(advice.outcome).to.eql('Aanspreken / informeren'));",
              "pm.test('it deviates from the advice', () => pm.expect(advice.accepted).to.eql(false));",
              "pm.test('the reason is kept', () => pm.expect(advice.reason).to.eql('Eerste overtreding, direct hersteld.'));",
              "pm.test('the advice itself is unchanged', () => pm.expect(advice.recommendation).to.eql('Waarschuwen'));"
            ]
          }
        }
      ]
    },
    {
      "name": "advice on a case: a decided advice is not decided again",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "OCS-APIRequest",
            "value": "true"
          }
        ],
        "url": "{{baseUrl}}/index.php/apps/dossiq/api/decision-advice/override",
        "body": {
          "mode": "raw",
          "raw": "{\"adviceId\": \"{{lhsAdviceId}}\", \"outcome\": \"Waarschuwen\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('refused (409)', () => pm.response.to.have.status(409));"
            ]
          }
        }
      ]
    }
  ]
}
