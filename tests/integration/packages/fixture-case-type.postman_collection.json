{
  "info": {
    "name": "dossiq package: fixture-case-type",
    "description": "Reads back, through the OpenRegister objects API, every row the package installer wrote for the neutral fixture package, and its ledger row. Run by .github/workflows/packages.yml after `occ dossiq:package:install --root tests/fixtures/packages fixture-case-type`.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "basic",
    "basic": [
      {
        "key": "username",
        "value": "{{adminUser}}",
        "type": "string"
      },
      {
        "key": "password",
        "value": "{{adminPass}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "adminUser",
      "value": "admin"
    },
    {
      "key": "adminPass",
      "value": "admin"
    }
  ],
  "item": [
    {
      "name": "case type",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "OCS-APIRequest",
            "value": "true"
          },
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/index.php/apps/openregister/api/objects/dossiq/caseType/0f1c0000-0000-4000-8000-000000000001"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('row is there (200)', () => pm.response.to.have.status(200));",
              "const row = pm.response.json();",
              "pm.test('title as shipped', () => pm.expect(row.title).to.eql('Fixture request'));"
            ]
          }
        }
      ]
    },
    {
      "name": "first status",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "OCS-APIRequest",
            "value": "true"
          },
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/index.php/apps/openregister/api/objects/dossiq/statusType/0f1c0000-0000-4000-8000-000000000011"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('row is there (200)', () => pm.response.to.have.status(200));",
              "const row = pm.response.json();",
              "pm.test('points at the case type', () => pm.expect(row.caseType).to.eql('0f1c0000-0000-4000-8000-000000000001'));",
              "pm.test('order 1', () => pm.expect(row.order).to.eql(1));"
            ]
          }
        }
      ]
    },
    {
      "name": "final status",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "OCS-APIRequest",
            "value": "true"
          },
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/index.php/apps/openregister/api/objects/dossiq/statusType/0f1c0000-0000-4000-8000-000000000012"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('row is there (200)', () => pm.response.to.have.status(200));",
              "const row = pm.response.json();",
              "pm.test('is final', () => pm.expect(row.isFinal).to.eql(true));"
            ]
          }
        }
      ]
    },
    {
      "name": "role",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "OCS-APIRequest",
            "value": "true"
          },
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/index.php/apps/openregister/api/objects/dossiq/roleType/0f1c0000-0000-4000-8000-000000000021"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('row is there (200)', () => pm.response.to.have.status(200));",
              "const row = pm.response.json();",
              "pm.test('name as shipped', () => pm.expect(row.name).to.eql('Handler'));"
            ]
          }
        }
      ]
    },
    {
      "name": "flow",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "OCS-APIRequest",
            "value": "true"
          },
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/index.php/apps/openregister/api/objects/dossiq/workflowTemplate/0f1c0000-0000-4000-8000-000000000031"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('row is there (200)', () => pm.response.to.have.status(200));",
              "const row = pm.response.json();",
              "pm.test('flow belongs to the case type', () => pm.expect(row.caseType).to.eql('0f1c0000-0000-4000-8000-000000000001'));"
            ]
          }
        }
      ]
    },
    {
      "name": "seed row",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "OCS-APIRequest",
            "value": "true"
          },
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/index.php/apps/openregister/api/objects/dossiq/propertyDefinition/0f1c0000-0000-4000-8000-000000000041"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('row is there (200)', () => pm.response.to.have.status(200));",
              "const row = pm.response.json();",
              "pm.test('seed row as shipped', () => pm.expect(row.name).to.eql('reference'));"
            ]
          }
        }
      ]
    },
    {
      "name": "ledger records the case type",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/index.php/apps/openregister/api/objects/dossiq/shippedOrigin?targetObject=0f1c0000-0000-4000-8000-000000000001&_limit=5"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('ledger reachable (200)', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "const rows = Array.isArray(body) ? body : (body.results || []);",
              "const row = rows.find(r => r.targetObject === '0f1c0000-0000-4000-8000-000000000001');",
              "pm.test('a ledger row names the package and its version', () => {",
              "    pm.expect(row, 'ledger row for the case type').to.be.an('object');",
              "    pm.expect(row.set).to.eql('fixture-case-type');",
              "    pm.expect(row.setVersion).to.eql('1.0.0');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "ledger records the package version",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/index.php/apps/openregister/api/objects/dossiq/shippedOrigin?targetSchema=package&targetObject=fixture-case-type&_limit=5"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('ledger reachable (200)', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "const rows = Array.isArray(body) ? body : (body.results || []);",
              "const records = rows.filter(r => r.targetSchema === 'package' && r.targetObject === 'fixture-case-type');",
              "pm.test('one version record names the package at 1.0.0', () => {",
              "    pm.expect(records).to.have.lengthOf(1);",
              "    pm.expect(records[0].set).to.eql('fixture-case-type');",
              "    pm.expect(records[0].setVersion).to.eql('1.0.0');",
              "});"
            ]
          }
        }
      ]
    }
  ]
}
