    {
      "name": "tender chain: the scoring sheet names the formula and asks only for quality",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "OCS-APIRequest",
            "value": "true"
          }
        ],
        "url": "{{baseUrl}}/index.php/apps/dossiq/api/cases/{{tenderCaseId}}/scoring"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('the sheet is read (200)', () => pm.expect(pm.response.code).to.eql(200));",
              "const sheet = pm.response.json();",
              "pm.test('scored by price-quality', () => pm.expect(sheet.formula.key).to.eql('price-quality'));",
              "pm.test('the evaluator enters only quality', () => pm.expect(sheet.inputs).to.eql(['quality']));",
              "pm.test('the case holds the weights', () => pm.expect(sheet.fixed).to.include({ qualityWeight: 0.6, priceWeight: 0.4, maxPoints: 100 }));",
              "pm.test('both admissible bids are offered, the late one is not there', () => pm.expect(sheet.submissions.map((s) => s.label).sort()).to.eql(['NEWMAN-A', 'NEWMAN-B']));"
            ]
          }
        }
      ]
