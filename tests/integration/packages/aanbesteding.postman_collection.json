{
  "info": {
    "name": "dossiq package: aanbesteding",
    "description": "Reads every kind of row the aanbesteding package writes back through the OpenRegister objects API, after the packages workflow installed it on a clean instance (hydra ADR-118). Ids are the fixed ids in lib/Settings/packages/aanbesteding/. Written by scripts/packages/package-to-newman.py. The tender chain requests after the read-backs are hand-written (openspec change tenders-run-on-the-tender-case-type task 1.5): they seed a supplier and a tender in evaluation scored by the price-quality formula, register two bids, refuse a late one naming the closing date, read the scoring sheet, score a bid through dossiq's scoring route and read its evaluation back, and refuse making the award final before the standstill ends (REQ-TND-CASE-01).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "basic",
    "basic": [
      {
        "key": "username",
        "value": "{{adminUser}}",
        "type": "string"
      },
