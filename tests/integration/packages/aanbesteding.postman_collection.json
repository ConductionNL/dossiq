    {
      "name": "tender chain: a supplier",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "OCS-APIRequest",
            "value": "true"
          }
        ],
        "url": "{{baseUrl}}/index.php/apps/openregister/api/objects/dossiq/supplier",
        "body": {
          "mode": "raw",
          "raw": "{\"kvkNumber\": \"{{tenderKvk}}\", \"legalName\": \"Newman Inschrijver BV\", \"status\": \"active\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const day = (offset) => new Date(Date.now() + offset * 86400000).toISOString().slice(0, 10);",
              "pm.collectionVariables.set('tenderClosing', day(-3));",
              "pm.collectionVariables.set('tenderStandstillEnd', day(20));",
              "pm.collectionVariables.set('tenderKvk', String(90000000 + Math.floor(Math.random() * 999999)));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('the supplier is written (200/201)', () => pm.expect(pm.response.code).to.be.oneOf([200, 201]));",
              "const unwrap = (b) => (b && (b.id || b['@self'] || b.uuid)) ? b : ((b && b.results && !Array.isArray(b.results)) ? b.results : ((b && b.object) || b));",
              "const idOf = (o) => String((o && o['@self'] && o['@self'].id) || (o && o.uuid) || (o && o.id) || '');",
              "const id = idOf(unwrap(pm.response.json()));",
              "pm.test('the supplier has an id', () => pm.expect(id).to.not.eql(''));",
              "pm.collectionVariables.set('tenderSupplierId', id);"
            ]
          }
        }
      ]
    },
