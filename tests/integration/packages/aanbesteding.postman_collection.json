      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('row is there (200)', () => pm.response.to.have.status(200));",
              "const row = pm.response.json();",
              "pm.test('title as shipped', () => pm.expect(row.title).to.eql(\"Aanbesteding\"));",
              "pm.test('identifier as shipped', () => pm.expect(row.identifier).to.eql(\"aanbesteding\"));",
              "pm.test('processingDeadline as shipped', () => pm.expect(row.processingDeadline).to.eql(\"P26W\"));",
              "pm.test('confidentiality as shipped', () => pm.expect(row.confidentiality).to.eql(\"zaakvertrouwelijk\"));",
              "pm.test('publicationRequired as shipped', () => pm.expect(row.publicationRequired).to.eql(true));"
