        "name": "{{ naam }}",
        "documentationLink": "{{ documentatieLink }}",
        "filters": "{{ filters|json_encode|raw }}"
    },
    "valueMapping": [],
    "queryParameterMapping": {
        "name": {
            "field": "name"
        }
    }
}
