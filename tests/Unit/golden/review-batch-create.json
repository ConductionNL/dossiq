            "taken [\"case-1\",[\"doc-1\",\"doc-2\"]]"
        ]
    },
    "selection refused": {
        "status": 422,
        "body": {
            "error": "review-batch-filter-unknown",
            "message": "A batch can be taken by custodian, source system, the rule that marked its documents, or a list of documents."
        },
        "calls": [
            "hasCaseMutationAccess case-1",
            "select [\"case-1\",[\"doc-1\",\"2\"],{\"custodian\":\"alice\"}]"
        ]
    },
    "create refused": {
        "status": 409,
        "body": {
            "error": "review-batch-name-required",
            "message": "Give the batch a name."
        },
        "calls": [
            "hasCaseMutationAccess case-1",
