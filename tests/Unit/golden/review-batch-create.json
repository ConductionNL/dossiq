            "message": "You do not have access to this case"
        },
        "calls": [
            "hasCaseMutationAccess case-1"
        ]
    },
    "made": {
        "status": 201,
        "body": {
            "id": "batch-1",
            "name": "Batch A"
        },
        "calls": [
            "hasCaseMutationAccess case-1",
            "select [\"case-1\",[\"doc-1\",\"2\"],{\"custodian\":\"alice\"}]",
            "taken [\"case-1\",[\"doc-1\",\"doc-2\"]]",
            "create [\"case-1\",\"Batch A\",\"reviewer\",[\"doc-1\",\"doc-2\"],\"coordinator\",{\"custodian\":\"alice\"}]"
        ]
    },
    "made without parameters": {
        "status": 201,
        "body": {
            "id": "batch-1",
            "name": ""
        },
        "calls": [
            "hasCaseMutationAccess case-1",
            "select [\"case-1\",[],[]]",
            "taken [\"case-1\",[\"doc-1\",\"doc-2\"]]",
            "create [\"case-1\",\"\",\"\",[\"doc-1\",\"doc-2\"],\"coordinator\",[]]"
        ]
    },
    "a document already in a batch": {
        "status": 409,
        "body": {
