            "taken [\"case-1\",[\"doc-1\",\"doc-2\"]]",
            "create [\"case-1\",\"Batch A\",\"reviewer\",[\"doc-1\",\"doc-2\"],\"coordinator\",{\"custodian\":\"alice\"}]"
