{
	"info": {
		"_postman_id": "m10b13l-1nsp-3ct13-0ffl1ne-syncapi001",
		"name": "Procest Mobiel Inspectie Offline — Sync API",
		"description": "API/contract coverage for the mobiel-inspectie-offline sync endpoints exposed by SyncController — GET /api/sync/daily, GET /api/sync/queue, POST /api/sync/queue/{id}/outcome, POST /api/sync/conflicts/{id}/resolve.\n\nEnv-independent contract + security assertions (no fixtures required):\n  - GET /api/sync/queue without deviceId returns 400,\n  - GET /api/sync/queue with deviceId returns 200 + {results,total} (empty for a fresh device),\n  - GET /api/sync/daily returns 200 + a payload with cases/checklists arrays,\n  - POST outcome without deviceId returns 400,\n  - POST outcome on an unknown operation id returns 404 (IDOR fail-closed — the op is not in the caller's own queue),\n  - POST conflicts resolve without deviceId returns 400,\n  - POST conflicts resolve on an unknown op id returns 404 (IDOR fail-closed).\n\nAuth is HTTP Basic + OCS-APIRequest. Defaults to admin:admin against http://localhost:8080.\n\nTraces openspec/specs/mobiel-inspectie-offline/spec.md",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"auth": {
		"type": "basic",
		"basic": [
			{"key": "username", "value": "{{admin_user}}", "type": "string"},
			{"key": "password", "value": "{{admin_pass}}", "type": "string"}
		]
	},
	"event": [
		{
			"listen": "prerequest",
			"script": {
				"type": "text/javascript",
				"exec": [
					"if (!pm.collectionVariables.get('device_id')) {",
					"  pm.collectionVariables.set('device_id', 'newman-device-' + Date.now().toString(36).toUpperCase());",
					"}"
				]
			}
		}
	],
	"item": [
		{
			"name": "SyncController — GET /api/sync/daily returns 200 + planning payload",
			"request": {
				"method": "GET",
				"header": [{"key": "OCS-APIRequest", "value": "true"}],
				"url": {
					"raw": "{{base_url}}/api/sync/daily",
					"host": ["{{base_url}}"],
					"path": ["api", "sync", "daily"]
				}
			},
			"event": [
				{"listen": "test", "script": {"type": "text/javascript", "exec": [
					"pm.test('200 OK', function () { pm.response.to.have.status(200) })",
					"var b = pm.response.json()",
					"pm.test('payload has cases array', function () { pm.expect(b.cases).to.be.an('array') })",
					"pm.test('payload has checklists array', function () { pm.expect(b.checklists).to.be.an('array') })"
				]}}
			]
		},
		{
			"name": "SyncController — GET /api/sync/queue without deviceId returns 400",
			"request": {
				"method": "GET",
				"header": [{"key": "OCS-APIRequest", "value": "true"}],
				"url": {
					"raw": "{{base_url}}/api/sync/queue",
					"host": ["{{base_url}}"],
					"path": ["api", "sync", "queue"]
				}
			},
			"event": [
				{"listen": "test", "script": {"type": "text/javascript", "exec": [
					"pm.test('400 Bad Request', function () { pm.response.to.have.status(400) })",
					"pm.test('error mentions deviceId', function () { pm.expect(pm.response.json().error || '').to.match(/deviceId/i) })"
				]}}
			]
		},
		{
			"name": "SyncController — GET /api/sync/queue with deviceId returns 200 + results/total",
			"request": {
				"method": "GET",
				"header": [{"key": "OCS-APIRequest", "value": "true"}],
				"url": {
					"raw": "{{base_url}}/api/sync/queue?deviceId={{device_id}}",
					"host": ["{{base_url}}"],
					"path": ["api", "sync", "queue"],
					"query": [{"key": "deviceId", "value": "{{device_id}}"}]
				}
			},
			"event": [
				{"listen": "test", "script": {"type": "text/javascript", "exec": [
					"pm.test('200 OK', function () { pm.response.to.have.status(200) })",
					"var b = pm.response.json()",
					"pm.test('has results array + numeric total', function () { pm.expect(b.results).to.be.an('array'); pm.expect(b.total).to.be.a('number') })",
					"pm.test('fresh device queue is empty', function () { pm.expect(b.total).to.eql(0) })"
				]}}
			]
		},
		{
			"name": "SyncController — POST outcome without deviceId returns 400",
			"request": {
				"method": "POST",
				"header": [
					{"key": "OCS-APIRequest", "value": "true"},
					{"key": "Content-Type", "value": "application/json"}
				],
				"body": {"mode": "raw", "raw": "{\"statusCode\":200}"},
				"url": {
					"raw": "{{base_url}}/api/sync/queue/op-unknown/outcome",
					"host": ["{{base_url}}"],
					"path": ["api", "sync", "queue", "op-unknown", "outcome"]
				}
			},
			"event": [
				{"listen": "test", "script": {"type": "text/javascript", "exec": [
					"pm.test('400 Bad Request', function () { pm.response.to.have.status(400) })",
					"pm.test('error mentions deviceId', function () { pm.expect(pm.response.json().error || '').to.match(/deviceId/i) })"
				]}}
			]
		},
		{
			"name": "SyncController — POST outcome on unknown op returns 404 (IDOR fail-closed)",
			"request": {
				"method": "POST",
				"header": [
					{"key": "OCS-APIRequest", "value": "true"},
					{"key": "Content-Type", "value": "application/json"}
				],
				"body": {"mode": "raw", "raw": "{\"deviceId\":\"{{device_id}}\",\"statusCode\":200}"},
				"url": {
					"raw": "{{base_url}}/api/sync/queue/op-not-mine/outcome",
					"host": ["{{base_url}}"],
					"path": ["api", "sync", "queue", "op-not-mine", "outcome"]
				}
			},
			"event": [
				{"listen": "test", "script": {"type": "text/javascript", "exec": [
					"pm.test('404 Not Found (operation not in caller queue)', function () { pm.response.to.have.status(404) })"
				]}}
			]
		},
		{
			"name": "SyncController — POST conflict resolve without deviceId returns 400",
			"request": {
				"method": "POST",
				"header": [
					{"key": "OCS-APIRequest", "value": "true"},
					{"key": "Content-Type", "value": "application/json"}
				],
				"body": {"mode": "raw", "raw": "{\"resolution\":\"client_wins\"}"},
				"url": {
					"raw": "{{base_url}}/api/sync/conflicts/op-unknown/resolve",
					"host": ["{{base_url}}"],
					"path": ["api", "sync", "conflicts", "op-unknown", "resolve"]
				}
			},
			"event": [
				{"listen": "test", "script": {"type": "text/javascript", "exec": [
					"pm.test('400 Bad Request', function () { pm.response.to.have.status(400) })",
					"pm.test('error mentions deviceId', function () { pm.expect(pm.response.json().error || '').to.match(/deviceId/i) })"
				]}}
			]
		},
		{
			"name": "SyncController — POST conflict resolve on unknown op returns 404 (IDOR fail-closed)",
			"request": {
				"method": "POST",
				"header": [
					{"key": "OCS-APIRequest", "value": "true"},
					{"key": "Content-Type", "value": "application/json"}
				],
				"body": {"mode": "raw", "raw": "{\"deviceId\":\"{{device_id}}\",\"resolution\":\"client_wins\"}"},
				"url": {
					"raw": "{{base_url}}/api/sync/conflicts/op-not-mine/resolve",
					"host": ["{{base_url}}"],
					"path": ["api", "sync", "conflicts", "op-not-mine", "resolve"]
				}
			},
			"event": [
				{"listen": "test", "script": {"type": "text/javascript", "exec": [
					"pm.test('404 Not Found (conflict op not in caller queue)', function () { pm.response.to.have.status(404) })"
				]}}
			]
		}
	]
}
