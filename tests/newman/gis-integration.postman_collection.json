{
	"info": {
		"name": "Procest — GIS integration (cases-on-map + OGC WFS)",
		"description": "Smoke + contract tests for the gis-integration endpoints: the cases-on-map data endpoint (/api/cases/geo, clustered GeoJSON with a per-object access guard) and the public OGC WFS 2.0.0 endpoint (/wfs/cases: GetCapabilities, DescribeFeatureType, GetFeature). Read-only and self-contained — they degrade to an empty FeatureCollection when no located cases exist, so no seed data is required. See openspec/specs/gis-integration/spec.md.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"auth": {
		"type": "basic",
		"basic": [
			{ "key": "username", "value": "{{admin_user}}", "type": "string" },
			{ "key": "password", "value": "{{admin_pass}}", "type": "string" }
		]
	},
	"item": [
		{
			"name": "GET /api/cases/geo — returns a GeoJSON FeatureCollection",
			"request": {
				"method": "GET",
				"header": [{ "key": "OCS-APIRequest", "value": "true" }],
				"url": {
					"raw": "{{base_url}}/api/cases/geo?zoom=7",
					"host": ["{{base_url}}"],
					"path": ["api", "cases", "geo"],
					"query": [{ "key": "zoom", "value": "7" }]
				}
			},
			"event": [
				{
					"listen": "test",
					"script": {
						"type": "text/javascript",
						"exec": [
							"pm.test('Status 200', function () { pm.response.to.have.status(200); });",
							"var body = pm.response.json();",
							"pm.test('Is a FeatureCollection', function () { pm.expect(body.type).to.eql('FeatureCollection'); });",
							"pm.test('Has a features array', function () { pm.expect(body.features).to.be.an('array'); });",
							"pm.test('Reports total + filtered counts', function () { pm.expect(body).to.have.property('total'); pm.expect(body).to.have.property('filtered'); });"
						]
					}
				}
			]
		},
		{
			"name": "GET /api/cases/geo — honours zaaktype/status filters (no 5xx)",
			"request": {
				"method": "GET",
				"header": [{ "key": "OCS-APIRequest", "value": "true" }],
				"url": {
					"raw": "{{base_url}}/api/cases/geo?zoom=16&zaaktype=omgevingsvergunning&status=open&bounds=4.8,52.3,4.9,52.4",
					"host": ["{{base_url}}"],
					"path": ["api", "cases", "geo"],
					"query": [
						{ "key": "zoom", "value": "16" },
						{ "key": "zaaktype", "value": "omgevingsvergunning" },
						{ "key": "status", "value": "open" },
						{ "key": "bounds", "value": "4.8,52.3,4.9,52.4" }
					]
				}
			},
			"event": [
				{
					"listen": "test",
					"script": {
						"type": "text/javascript",
						"exec": [
							"pm.test('Status 200', function () { pm.response.to.have.status(200); });",
							"var body = pm.response.json();",
							"pm.test('FeatureCollection shape preserved with filters', function () { pm.expect(body.type).to.eql('FeatureCollection'); pm.expect(body.features).to.be.an('array'); });"
						]
					}
				}
			]
		},
		{
			"name": "GET /wfs/cases?request=GetCapabilities — WFS 2.0.0 capabilities XML",
			"request": {
				"method": "GET",
				"header": [{ "key": "OCS-APIRequest", "value": "true" }],
				"url": {
					"raw": "{{base_url}}/wfs/cases?service=WFS&version=2.0.0&request=GetCapabilities",
					"host": ["{{base_url}}"],
					"path": ["wfs", "cases"],
					"query": [
						{ "key": "service", "value": "WFS" },
						{ "key": "version", "value": "2.0.0" },
						{ "key": "request", "value": "GetCapabilities" }
					]
				}
			},
			"event": [
				{
					"listen": "test",
					"script": {
						"type": "text/javascript",
						"exec": [
							"pm.test('Status 200', function () { pm.response.to.have.status(200); });",
							"pm.test('Content-Type is XML', function () { pm.expect(pm.response.headers.get('Content-Type') || '').to.match(/xml/i); });",
							"var text = pm.response.text();",
							"pm.test('Advertises WFS_Capabilities', function () { pm.expect(text).to.match(/WFS_Capabilities/); });",
							"pm.test('Advertises the procest:cases feature type', function () { pm.expect(text).to.match(/procest:cases/); });"
						]
					}
				}
			]
		},
		{
			"name": "GET /wfs/cases?request=DescribeFeatureType — XSD schema",
			"request": {
				"method": "GET",
				"header": [{ "key": "OCS-APIRequest", "value": "true" }],
				"url": {
					"raw": "{{base_url}}/wfs/cases?service=WFS&request=DescribeFeatureType",
					"host": ["{{base_url}}"],
					"path": ["wfs", "cases"],
					"query": [
						{ "key": "service", "value": "WFS" },
						{ "key": "request", "value": "DescribeFeatureType" }
					]
				}
			},
			"event": [
				{
					"listen": "test",
					"script": {
						"type": "text/javascript",
						"exec": [
							"pm.test('Status 200', function () { pm.response.to.have.status(200); });",
							"pm.test('Returns an XSD schema', function () { pm.expect(pm.response.text()).to.match(/xsd:schema/); });"
						]
					}
				}
			]
		},
		{
			"name": "GET /wfs/cases?request=GetFeature — GML FeatureCollection",
			"request": {
				"method": "GET",
				"header": [{ "key": "OCS-APIRequest", "value": "true" }],
				"url": {
					"raw": "{{base_url}}/wfs/cases?service=WFS&request=GetFeature&typename=procest:cases&bbox=4.8,52.3,4.9,52.4",
					"host": ["{{base_url}}"],
					"path": ["wfs", "cases"],
					"query": [
						{ "key": "service", "value": "WFS" },
						{ "key": "request", "value": "GetFeature" },
						{ "key": "typename", "value": "procest:cases" },
						{ "key": "bbox", "value": "4.8,52.3,4.9,52.4" }
					]
				}
			},
			"event": [
				{
					"listen": "test",
					"script": {
						"type": "text/javascript",
						"exec": [
							"pm.test('Status 200', function () { pm.response.to.have.status(200); });",
							"var text = pm.response.text();",
							"pm.test('Returns a wfs:FeatureCollection', function () { pm.expect(text).to.match(/wfs:FeatureCollection/); });",
							"pm.test('Reports numberReturned', function () { pm.expect(text).to.match(/numberReturned=/); });"
						]
					}
				}
			]
		},
		{
			"name": "GET /wfs/cases?request=Bogus — OGC ExceptionReport",
			"request": {
				"method": "GET",
				"header": [{ "key": "OCS-APIRequest", "value": "true" }],
				"url": {
					"raw": "{{base_url}}/wfs/cases?service=WFS&request=Bogus",
					"host": ["{{base_url}}"],
					"path": ["wfs", "cases"],
					"query": [
						{ "key": "service", "value": "WFS" },
						{ "key": "request", "value": "Bogus" }
					]
				}
			},
			"event": [
				{
					"listen": "test",
					"script": {
						"type": "text/javascript",
						"exec": [
							"pm.test('Status 400', function () { pm.response.to.have.status(400); });",
							"pm.test('Returns an OGC ExceptionReport', function () { pm.expect(pm.response.text()).to.match(/ows:ExceptionReport/); });"
						]
					}
				}
			]
		}
	]
}
