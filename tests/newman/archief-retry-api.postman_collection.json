{
	"info": {
		"name": "Procest Archief e-Depot Retry/Rollback REST API",
		"description": "Exercises the archief-edepot-handover-06 retry-after-correction endpoint (POST /api/archief/triggers/{triggerId}/retry) plus its IDOR/state guards. Self-contained: hits guard paths that never mutate state, so the collection is idempotent and safe to re-run against a live procest instance.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"auth": {
		"type": "basic",
		"basic": [
			{ "key": "username", "value": "{{admin_user}}", "type": "string" },
			{ "key": "password", "value": "{{admin_pass}}", "type": "string" }
		]
	},
	"event": [],
	"item": [
		{
			"name": "ArchiefController — POST /triggers/{id}/retry on unknown trigger returns 404 (IDOR guard, no state change)",
			"request": {
				"method": "POST",
				"header": [
					{ "key": "OCS-APIRequest", "value": "true" },
					{ "key": "Content-Type", "value": "application/json" }
				],
				"body": { "mode": "raw", "raw": "{}" },
				"url": {
					"raw": "{{base_url}}/api/archief/triggers/00000000-0000-0000-0000-000000000000/retry",
					"host": [ "{{base_url}}" ],
					"path": [ "api", "archief", "triggers", "00000000-0000-0000-0000-000000000000", "retry" ]
				}
			},
			"event": [
				{
					"listen": "test",
					"script": {
						"type": "text/javascript",
						"exec": [
							"pm.test('unknown trigger -> 404 (or 503 when OR unconfigured), never 500/200-success', function () {",
							"  pm.expect(pm.response.code).to.be.oneOf([404, 503]);",
							"});"
						]
					}
				}
			]
		},
		{
			"name": "ArchiefController — POST /triggers//retry with empty id is not a success",
			"request": {
				"method": "POST",
				"header": [
					{ "key": "OCS-APIRequest", "value": "true" },
					{ "key": "Content-Type", "value": "application/json" }
				],
				"body": { "mode": "raw", "raw": "{}" },
				"url": {
					"raw": "{{base_url}}/api/archief/triggers/%20/retry",
					"host": [ "{{base_url}}" ],
					"path": [ "api", "archief", "triggers", "%20", "retry" ]
				}
			},
			"event": [
				{
					"listen": "test",
					"script": {
						"type": "text/javascript",
						"exec": [
							"pm.test('blank/whitespace trigger id -> 4xx or 404/503, never a 2xx retry', function () {",
							"  pm.expect(pm.response.code).to.be.oneOf([400, 404, 503]);",
							"});"
						]
					}
				}
			]
		},
		{
			"name": "Auth — POST /triggers/{id}/retry without credentials is rejected (no state change)",
			"request": {
				"auth": { "type": "noauth" },
				"method": "POST",
				"header": [
					{ "key": "OCS-APIRequest", "value": "true" },
					{ "key": "Content-Type", "value": "application/json" }
				],
				"body": { "mode": "raw", "raw": "{}" },
				"url": {
					"raw": "{{base_url}}/api/archief/triggers/00000000-0000-0000-0000-000000000000/retry",
					"host": [ "{{base_url}}" ],
					"path": [ "api", "archief", "triggers", "00000000-0000-0000-0000-000000000000", "retry" ]
				}
			},
			"event": [
				{
					"listen": "test",
					"script": {
						"type": "text/javascript",
						"exec": [
							"pm.test('anonymous retry is rejected (401/403), never executes', function () {",
							"  pm.expect(pm.response.code).to.be.oneOf([401, 403]);",
							"});"
						]
					}
				}
			]
		}
	],
	"variable": [
		{ "key": "base_url", "value": "http://localhost:8080/index.php/apps/procest" },
		{ "key": "admin_user", "value": "admin" },
		{ "key": "admin_pass", "value": "admin" }
	]
}
