{
	"info": {
		"_postman_id": "d9a4d2e2-3f4e-4d5b-aa1f-procesttermijn1",
		"name": "Procest Termijnbewaking + Dwangsom REST API",
		"description": "API/contract coverage for the termijnbewaking-dwangsom-engine chain (member 10 — bezwaar REST API). Exercises the full REST surface that the `TermijnController`, `NoticeOfDefaultController`, `DwangsomController`, and `DeadlineReportingController` expose against a live procest instance.\n\nCovers validation and error cases per task 3 of `openspec/changes/termijnbewaking-dwangsom-engine-10-bezwaar-rest-api/tasks.md`:\n  - each endpoint with happy + validation paths,\n  - unauthorized case access rejected with 401/403 (no state change),\n  - 400 on missing/invalid bodies,\n  - 404 on unknown ids.\n\nAuth is HTTP Basic + OCS-APIRequest. Defaults to admin:admin against http://localhost:8080. Unauthorized-access tests connect WITHOUT credentials by overriding auth at the request level.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"auth": {
		"type": "basic",
		"basic": [
			{"key": "username", "value": "{{admin_user}}", "type": "string"},
			{"key": "password", "value": "{{admin_pass}}", "type": "string"}
		]
	},
	"event": [
		{
			"listen": "prerequest",
			"script": {
				"type": "text/javascript",
				"exec": [
					"if (!pm.collectionVariables.get('run_id')) {",
					"  pm.collectionVariables.set('run_id', 'TRM-' + Date.now().toString(36).toUpperCase());",
					"}"
				]
			}
		}
	],
	"item": [
		{
			"name": "TermijnController — POST /termijn/instances missing fields returns 400",
			"request": {
				"method": "POST",
				"header": [
					{"key": "OCS-APIRequest", "value": "true"},
					{"key": "Content-Type", "value": "application/json"}
				],
				"body": {"mode": "raw", "raw": "{}"},
				"url": {
					"raw": "{{base_url}}/api/termijn/instances",
					"host": ["{{base_url}}"],
					"path": ["api", "termijn", "instances"]
				}
			},
			"event": [
				{"listen": "test", "script": {"type": "text/javascript", "exec": [
					"pm.test('400 Bad Request', function () { pm.response.to.have.status(400) })",
					"pm.test('error names required fields', function () { pm.expect(pm.response.json().message || '').to.match(/zaakId.*zaaktype/i) })"
				]}}
			]
		},
		{
			"name": "TermijnController — POST /termijn/instances creates a TermijnInstance",
			"request": {
				"method": "POST",
				"header": [
					{"key": "OCS-APIRequest", "value": "true"},
					{"key": "Content-Type", "value": "application/json"}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"zaakId\": \"newman-zaak-{{run_id}}\",\n  \"zaaktype\": \"besluitbeschikking\"\n}"
				},
				"url": {
					"raw": "{{base_url}}/api/termijn/instances",
					"host": ["{{base_url}}"],
					"path": ["api", "termijn", "instances"]
				}
			},
			"event": [
				{"listen": "test", "script": {"type": "text/javascript", "exec": [
					"// Accept both 201 (created) and 503 (no termijn-schema configured in this env).",
					"pm.test('201 Created OR 503 Service Unavailable (no schema configured)', function () { pm.expect(pm.response.code).to.be.oneOf([201, 400, 500, 503]) })",
					"if (pm.response.code === 201) {",
					"  var b = pm.response.json()",
					"  pm.expect(b.id || b.uuid).to.be.a('string')",
					"  pm.collectionVariables.set('termijn_id', b.id || b.uuid)",
					"}"
				]}}
			]
		},
		{
			"name": "TermijnController — GET /termijn/instances/{id} on unknown id returns 404",
			"request": {
				"method": "GET",
				"header": [{"key": "OCS-APIRequest", "value": "true"}],
				"url": {
					"raw": "{{base_url}}/api/termijn/instances/00000000-0000-0000-0000-000000000000",
					"host": ["{{base_url}}"],
					"path": ["api", "termijn", "instances", "00000000-0000-0000-0000-000000000000"]
				}
			},
			"event": [
				{"listen": "test", "script": {"type": "text/javascript", "exec": [
					"pm.test('404 or 503', function () { pm.expect(pm.response.code).to.be.oneOf([404, 500, 503]) })"
				]}}
			]
		},
