{
	"info": {
		"name": "kcc-werkplek-api — belplan + specialist beschikbaarheid",
		"description": "Gate-25 contract tests for the KCC-werkplek bridge read endpoints shipped by kcc-werkplek-zaaksysteem-bridge: belplan listing (seeded defaults) and specialist-beschikbaarheid polling. Write/quick-action endpoints mutate cases and are covered by PHPUnit; DigiD and the telephony transfer are cross-app (OpenConnector / pipelinq).",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"auth": {
		"type": "basic",
		"basic": [
			{ "key": "username", "value": "{{admin_user}}", "type": "string" },
			{ "key": "password", "value": "{{admin_pass}}", "type": "string" }
		]
	},
	"item": [
		{
			"name": "GET /api/kcc/belplannen — returns a JSON list, not SPA HTML",
			"request": {
				"method": "GET",
				"header": [ { "key": "OCS-APIRequest", "value": "true" } ],
				"url": {
					"raw": "{{base_url}}/api/kcc/belplannen",
					"host": [ "{{base_url}}" ],
					"path": [ "api", "kcc", "belplannen" ]
				}
			},
			"event": [
				{
					"listen": "test",
					"script": {
						"type": "text/javascript",
						"exec": [
							"pm.test('status is 200', function () { pm.response.to.have.status(200); });",
							"pm.test('response is JSON (route resolves before SPA catch-all)', function () {",
							"    pm.expect(pm.response.headers.get('Content-Type') || '').to.include('json');",
							"});",
							"pm.test('body is an object/array envelope', function () {",
							"    var body = pm.response.json();",
							"    pm.expect(body).to.not.be.undefined;",
							"});"
						]
					}
				}
			]
		},
		{
			"name": "GET /api/kcc/specialist-beschikbaarheid — read-only poll returns JSON",
			"request": {
				"method": "GET",
				"header": [ { "key": "OCS-APIRequest", "value": "true" } ],
				"url": {
					"raw": "{{base_url}}/api/kcc/specialist-beschikbaarheid?vaardigheid=omgevingsvergunning",
					"host": [ "{{base_url}}" ],
					"path": [ "api", "kcc", "specialist-beschikbaarheid" ],
					"query": [ { "key": "vaardigheid", "value": "omgevingsvergunning" } ]
				}
			},
			"event": [
				{
					"listen": "test",
					"script": {
						"type": "text/javascript",
						"exec": [
							"pm.test('status is 200', function () { pm.response.to.have.status(200); });",
							"pm.test('response is JSON (not SPA HTML)', function () {",
							"    pm.expect(pm.response.headers.get('Content-Type') || '').to.include('json');",
							"});"
						]
					}
				}
			]
		},
		{
			"name": "GET /api/contactmomenten without burgerId — 400 (server-validated, no IDOR)",
			"request": {
				"method": "GET",
				"header": [ { "key": "OCS-APIRequest", "value": "true" } ],
				"url": {
					"raw": "{{base_url}}/api/contactmomenten",
					"host": [ "{{base_url}}" ],
					"path": [ "api", "contactmomenten" ]
				}
			},
			"event": [
				{
					"listen": "test",
					"script": {
						"type": "text/javascript",
						"exec": [
							"pm.test('missing burgerId is rejected (400), not a silent list', function () {",
							"    pm.expect(pm.response.code).to.be.oneOf([400, 401]);",
							"});"
						]
					}
				}
			]
		}
	]
}
