{
	"_meta": {
		"spdx-license": "EUPL-1.2",
		"spdx-copyright": "2026 Conduction B.V.",
		"board": "DqPostvak",
		"note": "The organisation's mailbox of messages that belong to no case yet: the intake triage queue (outcome inbox or quarantined, sleeping items left out), read through dossiq's own /api/intake/triage, which holds the intake-role check. The generic object endpoint would apply the register's permissions instead and show the originals to anyone the register lets read, so the list is an endpoint source (`entitySource: endpoint`) over that route and never the schema's own endpoint. Each row carries the case its subject quotes (`suggestion`, CaseMatchSuggestion). The endpoint source (nextcloud-vue #1750) and the `actions` cell widget are nextcloud-vue keys in progress (L25); until they land the page lists nothing rather than the wrong rows."
	},
	"pages": [
		{
			"id": "Postvak",
			"route": "/postvak",
			"type": "index",
			"title": "Mailbox",
			"config": {
				"entitySource": "endpoint",
				"sourceConfig": {
					"url": "/apps/dossiq/api/intake/triage",
					"rowsPath": "results"
				},
				"showTitle": true,
				"headerMeta": "messages for the whole organisation that belong to no case yet",
				"countText": "{shown} of {total} messages",
				"footerNote": "{shown} of {total} · 20 per page",
				"searchPlaceholder": "Search sender or subject",
				"showAdd": false,
				"showViewAction": false,
				"allowSavedViews": false,
				"headerButtons": [
					{
						"action": "export",
						"label": "Download",
						"icon": "TrayArrowDown"
					}
				],
				"quickFilters": [
					{
						"label": "All",
						"filter": {},
						"default": true,
						"showCount": true
					},
					{
						"label": "Looks like a case",
						"filter": {
							"suggestion": "IS NOT NULL"
						},
						"showCount": true
					},
					{
						"label": "No case",
						"filter": {
							"suggestion": "IS NULL"
						},
						"showCount": true
					}
				],
				"columns": [
					{
						"key": "subject",
						"label": "Message",
						"width": "300px",
						"cellClass": "cn-cell--strong",
						"secondary": "{sender} · {receivedAt|relativetime}"
					},
					{
						"key": "recipient",
						"label": "Came in via",
						"width": "230px"
					},
					{
						"key": "suggestion.identifier",
						"label": "Proposal",
						"width": "186px",
						"widget": "badge",
						"widgetProps": {
							"variant": "info"
						}
					},
					{
						"key": "actions",
						"label": "Do",
						"widget": "actions",
						"widgetProps": {
							"actions": [
								"link-to-case",
								"new-case-from-message"
							]
						}
					}
				],
				"actions": [
					{
						"id": "link-to-case",
						"label": "Link to case",
						"type": "handler",
						"handler": "navigate",
						"route": "CaseDetail",
						"params": {
							"id": "@row.suggestion.case"
						}
					},
					{
						"id": "new-case-from-message",
						"label": "New case",
						"type": "handler",
						"handler": "navigate",
						"route": "Cases"
					}
				],
				"documentationUrl": "https://dossiq.conduction.nl"
			}
		}
	]
}
