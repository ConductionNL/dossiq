								"publicationRequired",
								"validFrom",
								"validUntil"
							],
							"hideEmpty": false
						}
					}
				],
				"layout": [
					{
						"id": "1",
						"widgetId": "decision-type-core",
						"gridX": 0,
						"gridY": 0,
						"gridWidth": 12,
						"gridHeight": 8,
						"showTitle": true
					}
				]
			}
		}
	]
}
