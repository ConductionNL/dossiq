{
	"_meta": {
		"spdx-license": "EUPL-1.2",
		"spdx-copyright": "2026 Conduction B.V.",
		"why": "The parts of a case type (status, field, result, role, document type, decision type) each get a page of their own, opened from their lists on CaseTypeDetail, so a row can be read and edited there instead of only in the retired admin-settings editor. The page edits through the generic whole-record Edit dialog; the status checklist and field rules, and the field type vocabulary, are not expressed here."
	},
	"pages": [
		{
			"id": "StatusTypeDetail",
			"route": "/settings/status-types/:id",
			"type": "detail",
			"title": "Status",
			"permission": "admin",
			"config": {
				"register": "dossiq",
				"schema": "statusType",
				"titleField": "name",
				"showTypeEyebrow": false,
				"breadcrumb": {
					"label": "Case types",
					"route": "CaseTypes"
				},
				"documentationUrl": "https://dossiq.conduction.nl",
				"widgets": [
					{
						"id": "status-type-core",
						"type": "data",
						"title": "Status",
						"content": {
							"columns": 2,
							"include": [
								"name",
								"order",
								"isFinal",
								"description",
								"publicLabel",
								"publicDescription",
								"role",
								"colour",
								"waitingOn",
								"maximumDwell",
								"capacity",
								"phaseTermDays",
								"hiddenInLists"
							],
							"hideEmpty": false
						}
					}
				],
				"layout": [
					{
						"id": "1",
						"widgetId": "status-type-core",
						"gridX": 0,
						"gridY": 0,
						"gridWidth": 12,
						"gridHeight": 8,
						"showTitle": true
					}
				]
			}
		},
