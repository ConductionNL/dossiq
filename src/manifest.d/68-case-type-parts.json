{
	"_meta": {
		"spdx-license": "EUPL-1.2",
		"spdx-copyright": "2026 Conduction B.V.",
		"why": "A status and a field of a case type each get a page of their own, opened from the Statuses and Fields lists on CaseTypeDetail, so a row can be read and edited there instead of only in the retired admin-settings editor. The page edits through the generic whole-record Edit dialog; the status checklist and field rules, and the field type vocabulary, are not expressed here."
	},
	"pages": [
		{
			"id": "StatusTypeDetail",
			"route": "/settings/status-types/:id",
			"type": "detail",
			"title": "Status",
			"permission": "admin",
			"config": {
				"register": "dossiq",
				"schema": "statusType",
				"titleField": "name",
				"showTypeEyebrow": false,
				"breadcrumb": {
					"label": "Case types",
					"route": "CaseTypes"
				},
				"documentationUrl": "https://dossiq.conduction.nl",
				"widgets": [
					{
						"id": "status-type-core",
						"type": "data",
						"title": "Status",
						"content": {
							"columns": 2,
							"include": [
								"name",
								"order",
								"isFinal",
								"description",
								"publicLabel",
								"publicDescription",
								"role",
								"colour",
								"waitingOn",
								"maximumDwell",
								"capacity",
								"phaseTermDays",
								"hiddenInLists"
							],
							"hideEmpty": false
						}
					}
				],
				"layout": [
					{ "id": "1", "widgetId": "status-type-core", "gridX": 0, "gridY": 0, "gridWidth": 12, "gridHeight": 8, "showTitle": true }
				]
			}
		},
		{
			"id": "PropertyDefinitionDetail",
			"route": "/settings/attributes/:id",
			"type": "detail",
			"title": "Attribute",
			"permission": "admin",
			"config": {
				"register": "dossiq",
				"schema": "propertyDefinition",
				"titleField": "name",
				"showTypeEyebrow": false,
				"breadcrumb": {
					"label": "Attributes",
					"route": "PropertyDefinitions"
				},
				"documentationUrl": "https://dossiq.conduction.nl",
				"widgets": [
					{
						"id": "property-definition-core",
						"type": "data",
						"title": "Attribute",
						"content": {
							"columns": 2,
							"include": [
								"name",
								"definition",
								"description",
								"category",
								"propertyType",
								"isRequired",
								"requiredAtStatus",
								"defaultValue",
								"hideOnCreate",
								"propertySource",
								"maxLength",
								"minimum",
								"maximum",
								"pattern",
								"conceptScheme"
							],
							"hideEmpty": false
						}
					}
				],
				"layout": [
					{ "id": "1", "widgetId": "property-definition-core", "gridX": 0, "gridY": 0, "gridWidth": 12, "gridHeight": 8, "showTitle": true }
				]
			}
		}
	]
}
