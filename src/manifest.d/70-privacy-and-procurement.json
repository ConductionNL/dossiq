{
	"_meta": {
		"spdx-license": "EUPL-1.2",
		"spdx-copyright": "2026 Conduction B.V.",
		"change": "screens-round12-domain-lists",
		"boards": "DqContracten",
		"why": "The contracts and suppliers lists the board draws. Contracts are `supplierContract` rows and suppliers are `supplier` rows, both already in the register. The data subject requests list that sat here is a view of the Cases page now (`data-subject-requests`, Ruben, 19 October 2026); /privacy/requests redirects there."
	},
	"pages": [
		{
			"id": "Contracts",
			"route": "/procurement/contracts",
			"type": "index",
			"title": "Contracts",
			"config": {
				"showTitle": true,
				"register": "dossiq",
				"schema": "supplierContract",
				"breadcrumb": {
					"label": "Procurement",
					"route": "Contracts"
				},
				"pageTabs": [
					{
						"label": "Contracts",
						"route": "Contracts",
						"countFrom": {
							"register": "dossiq",
							"schema": "supplierContract",
							"filter": {}
						}
					},
					{
						"label": "Suppliers",
						"route": "Suppliers",
						"countFrom": {
							"register": "dossiq",
							"schema": "supplier",
							"filter": {}
						}
					},
					{
						"label": "Portal accounts",
						"route": "SupplierUsers",
						"adminOnly": true
					}
				],
				"headerMeta": "{total} contracts",
				"addLabel": "New contract",
				"headerButtons": [
					{
						"action": "export",
						"label": "Download",
						"icon": "TrayArrowDown"
					},
					{
						"action": "add",
						"label": "New contract",
						"variant": "primary",
						"icon": "Plus"
					}
				],
				"searchPlaceholder": "Search a contract or supplier",
				"footerNote": "20 per page",
				"notice": {
					"variant": "info",
					"text": "Renewing and terminating are decisions. dossiq asks decidiq for them, which checks the mandate; the outcome comes back onto the contract. The expiry signal runs in dossiq."
				},
				"_defaultFiltersNote": "Board DqContracten opens on the running contracts with \"Status: actief en verlopend\" on the Active line, removable with its chip or Alles wissen: a default filter, not a fixed one. It names every status a running contract has, so only a contract without a status falls outside it.",
				"defaultFilters": {
					"status": [
						"active",
						"renewal-decision",
						"termination-decision",
						"ending"
					]
				},
				"quickFilters": [
					{
						"label": "All",
						"showCount": true,
						"filter": {},
						"default": true
					},
					{
						"label": "Active",
						"showCount": true,
						"filter": {
							"status": "active"
						}
					},
					{
						"label": "Expires within 6 months",
						"showCount": true,
						"filter": {
							"renewalWarning": true
						}
					},
					{
						"label": "Decision needed",
						"showCount": true,
						"filter": {
							"status": ["renewal-decision", "termination-decision"]
						}
					}
				],
				"columns": [
					{
						"key": "subject",
						"label": "Contract",
						"secondary": "{number}"
					},
					{
						"key": "supplierRef",
						"label": "Supplier",
						"widget": "fkResolve",
						"widgetProps": {
							"register": "dossiq",
							"schema": "supplier",
							"labelField": "legalName"
						}
					},
					{
						"key": "value",
						"label": "Value",
						"formatter": "currency"
					},
					{
						"key": "endDate",
						"label": "End date",
						"formatter": "date"
					},
					{
						"key": "status",
						"label": "Status",
						"widget": "badge",
						"widgetProps": {
							"colorMap": {
								"active": "success",
								"renewal-decision": "warning",
								"termination-decision": "warning",
								"ending": "neutral"
							}
						}
					}
				],
				"defaultSort": [
					{
						"field": "endDate",
						"order": "asc"
					}
				],
				"showViewAction": true,
				"sidebar": {
					"enabled": true,
					"showMetadata": true
				},
				"documentationUrl": "https://dossiq.conduction.nl"
			}
		},
		{
			"id": "Suppliers",
			"route": "/procurement/suppliers",
			"type": "index",
			"title": "Suppliers",
			"config": {
				"showTitle": true,
				"register": "dossiq",
				"schema": "supplier",
				"breadcrumb": {
					"label": "Procurement",
					"route": "Contracts"
				},
				"pageTabs": [
					{
						"label": "Contracts",
						"route": "Contracts",
						"countFrom": {
							"register": "dossiq",
							"schema": "supplierContract",
							"filter": {}
						}
					},
					{
						"label": "Suppliers",
						"route": "Suppliers",
						"countFrom": {
							"register": "dossiq",
							"schema": "supplier",
							"filter": {}
						}
					},
					{
						"label": "Portal accounts",
						"route": "SupplierUsers",
						"adminOnly": true
					}
				],
				"headerMeta": "{total} suppliers",
				"addLabel": "New supplier",
				"headerButtons": [
					{
						"action": "export",
						"label": "Download",
						"icon": "TrayArrowDown"
					},
					{
						"action": "add",
						"label": "New supplier",
						"variant": "primary",
						"icon": "Plus"
					}
				],
				"rowIcon": "OfficeBuildingOutline",
				"columns": [
					{
						"key": "legalName",
						"label": "Name",
						"secondary": "{kvkNumber}"
					},
					"contactPerson",
					"contactEmail",
					{
						"key": "status",
						"label": "Status",
						"widget": "badge"
					},
					{
						"key": "qualityStatus",
						"label": "Quality",
						"widget": "badge"
					}
				],
				"defaultSort": [
					{
						"field": "legalName",
						"order": "asc"
					}
				],
				"showViewAction": true,
				"sidebar": {
					"enabled": true,
					"showMetadata": true
				},
				"documentationUrl": "https://dossiq.conduction.nl"
			}
		}
	]
}
