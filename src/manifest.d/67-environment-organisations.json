{
	"_meta": {
		"spdx-license": "EUPL-1.2",
		"spdx-copyright": "2026 Conduction B.V.",
		"board": "DqTenant",
		"why": "The organisations on this environment. A tenant is an OpenRegister organisation (tenancy-onto-openregister-organisation), so the list and the page read OpenRegister's organisations through the library's organisations entity source and keep no tenant store of their own; the tabs list the dossiq satellites that point at the organisation by tenantRef. Not the retired Tenants pages: those administered dossiq's own tenant store."
	},
	"menu": [
		{
			"id": "EnvironmentOrganisationsMenu",
			"label": "Organisations on this environment",
			"icon": "DomainSwitch",
			"route": "EnvironmentOrganisations",
			"section": "settings",
			"order": 98,
			"permission": "admin"
		}
	],
	"pages": [
		{
			"id": "EnvironmentOrganisations",
			"route": "/settings/organisations",
			"type": "index",
			"title": "Organisations on this environment",
			"permission": "admin",
			"config": {
				"entitySource": "organisations",
				"rowRoute": "EnvironmentOrganisationDetail",
				"showTitle": true,
				"breadcrumb": {
					"label": "Settings",
					"href": "/index.php/settings/admin/dossiq"
				},
				"headerMeta": "{total} organisations",
				"columns": [
					{
						"key": "name",
						"label": "Organisation",
						"cellClass": "cn-cell--strong",
						"secondary": "{slug}"
					},
					{
						"key": "status",
						"label": "Status"
					},
					{
						"key": "type",
						"label": "Type"
					},
					{
						"key": "created",
						"label": "Since"
					}
				],
				"documentationUrl": "https://dossiq.conduction.nl"
			}
		},
		{
			"id": "EnvironmentOrganisationDetail",
			"route": "/settings/organisations/:id",
			"type": "detail",
			"title": "Organisation",
			"permission": "admin",
			"config": {
				"entitySource": "organisations",
				"titleField": "name",
				"showTypeEyebrow": false,
				"breadcrumb": {
					"label": "Organisations on this environment",
					"route": "EnvironmentOrganisations"
				},
				"statusPill": {
					"field": "status",
					"labels": {
						"active": "Active",
						"suspended": "Suspended",
						"provisioning": "Setting up",
						"deprovisioned": "Ended"
					},
					"colorMap": {
						"active": "success",
						"suspended": "warning",
						"provisioning": "info",
						"deprovisioned": "default"
					}
				},
				"headerFields": [
					{
						"key": "slug"
					}
				],
				"actionsMenu": {
					"showRefresh": false,
					"showHelpLinks": false,
					"label": "More"
				},
				"_headerActionsNote": "Board DqTenant: Suspend in the header, End under More, as the Status card says. A tenant is an OpenRegister organisation, so these are OpenRegister's own lifecycle calls (PUT /api/organisations/{uuid}/suspend | activate | deprovision, admin-only, the service refusing a transition the status does not allow). Resume replaces Suspend while the organisation is suspended. The board's Edit is not here: OpenRegister updates an organisation with PUT /api/organisations/{uuid}, but no library form posts its fields to an endpoint that is not a register schema.",
				"headerActions": [
					{
						"id": "organisation-suspend",
						"type": "api-call",
						"label": "Suspend",
						"icon": "PauseCircleOutline",
						"url": "/apps/openregister/api/organisations/@objectId/suspend",
						"method": "PUT",
						"confirm": true,
						"successMessage": "The organisation is suspended. Nobody in it can sign in; its data stays.",
						"errorMessage": "The organisation was not suspended.",
						"visibleWhen": {
							"field": "status",
							"op": "eq",
							"value": "active"
						}
					},
					{
						"id": "organisation-resume",
						"type": "api-call",
						"label": "Resume",
						"icon": "Play",
						"url": "/apps/openregister/api/organisations/@objectId/activate",
						"method": "PUT",
						"successMessage": "The organisation is active again.",
						"errorMessage": "The organisation was not resumed.",
						"visibleWhen": {
							"field": "status",
							"op": "eq",
							"value": "suspended"
						}
					},
					{
						"id": "organisation-end",
						"type": "api-call",
						"label": "End the organisation",
						"icon": "StopCircleOutline",
						"url": "/apps/openregister/api/organisations/@objectId/deprovision",
						"method": "PUT",
						"confirm": true,
						"successMessage": "The organisation is ended.",
						"errorMessage": "The organisation was not ended."
					}
				],
				"quickActions": [
					"organisation-suspend",
					"organisation-resume"
				],
				"documentationUrl": "https://dossiq.conduction.nl",
				"sideColumn": [
					{
						"id": "organisation-side-status",
						"type": "facts",
						"title": "Status",
						"content": {
							"fields": [
								{
									"as": "pill",
									"path": "status",
									"map": {
										"active": "Active",
										"suspended": "Suspended",
										"provisioning": "Setting up",
										"deprovisioned": "Ended"
									}
								},
								{
									"label": "Since",
									"path": "created",
									"format": "date"
								},
								{
									"label": "Identifier",
									"path": "slug"
								},
								{
									"as": "line",
									"text": "Suspending blocks signing in; the data stays. Ending is under More."
								}
							]
						}
					},
					{
						"id": "organisation-side-admin",
						"type": "facts",
						"title": "Administrator",
						"content": {
							"fields": [
								{
									"label": "Owner",
									"path": "owner",
									"format": "user"
								},
								{
									"label": "Email",
									"path": "contactEmail",
									"format": "email"
								}
							],
							"emptyText": "No administrator named yet"
						}
					},
					{
						"id": "organisation-side-history",
						"type": "facts",
						"title": "Record history",
						"content": {
							"fields": [
								{
									"as": "text",
									"parts": [
										{
											"text": "Last changed on"
										},
										{
											"path": "updated",
											"format": "date-long"
										}
									],
									"separator": " "
								},
								{
									"as": "text",
									"parts": [
										{
											"text": "Created on"
										},
										{
											"path": "created",
											"format": "date-long"
										}
									],
									"separator": " "
								}
							]
						}
					}
				],
				"widgets": [
					{
						"id": "organisation-panels",
						"type": "tabs",
						"title": "Organisation parts",
						"content": {
							"ariaLabel": "Organisation parts",
							"tabs": [
								{
									"label": "Overview",
									"widgetIds": [
										"organisation-onboarding",
										"organisation-quota",
										"organisation-mandates",
										"organisation-billing"
									]
								},
								{
									"label": "Users",
									"widgetId": "organisation-users",
									"countFrom": "widget"
								},
								{
									"label": "Mandates",
									"widgetId": "organisation-mandates-list",
									"countFrom": "widget"
								},
								{
									"label": "Billing",
									"widgetId": "organisation-billing-list",
									"countFrom": "widget"
								}
							]
						}
					},
					{
						"id": "organisation-onboarding",
						"type": "record-list",
						"title": "Set up",
						"icon": "ClipboardCheckOutline",
						"content": {
							"endpointSource": {
								"url": "/apps/dossiq/api/saas/tenants/@objectId/onboarding/progress",
								"responsePath": "progress.steps"
							},
							"limit": 7,
							"presentation": "rows",
							"title": "{step}",
							"meta": "{completedAt|date}",
							"valueLabels": {
								"step": {
									"contract": "Contract signed",
									"mandate_import": "Mandates set",
									"sso_setup": "Sign-in set up",
									"branding": "House style chosen",
									"zaaktype_selection": "Case types loaded",
									"first_user": "Administrator invited",
									"go_live": "Gone live"
								}
							},
							"pill": {
								"field": "status",
								"labels": {
									"pending": "To do",
									"in_progress": "In progress",
									"completed": "Done",
									"skipped": "Skipped"
								},
								"colorMap": {
									"pending": "default",
									"in_progress": "info",
									"completed": "success",
									"skipped": "default"
								}
							},
							"emptyText": "Onboarding has not started for this organisation"
						}
					},
					{
						"id": "organisation-quota",
						"type": "facts",
						"title": "Quota",
						"content": {
							"fields": [
								{
									"as": "meter",
									"key": "users",
									"label": "Users",
									"path": "usage.users"
								},
								{
									"as": "meter",
									"key": "storage",
									"label": "Storage",
									"path": "usage.storage",
									"limitPath": "quota.storage",
									"format": "bytes"
								},
								{
									"as": "meter",
									"key": "requests",
									"label": "Requests this hour",
									"path": "usage.requests",
									"limitPath": "quota.requests"
								}
							],
							"emptyText": "No usage recorded for this organisation"
						}
					},
					{
						"id": "organisation-mandates",
						"type": "object-list",
						"title": "Mandates",
						"content": {
							"register": "dossiq",
							"schema": "tenantMandate",
							"filter": {
								"tenantRef": "@objectId"
							},
							"limit": 5,
							"columns": [
								{
									"key": "mandateMatrixRef",
									"label": "Role"
								},
								{
									"key": "terms.plafond",
									"label": "Decides up to",
									"format": {
										"style": "currency",
										"currency": "EUR",
										"decimals": 0
									},
									"emptyLabel": "Unlimited"
								},
								{
									"key": "terms.decisionTypes",
									"label": "Decides objections",
									"contains": "bezwaar",
									"valueLabels": {
										"true": "Yes",
										"false": "No"
									}
								},
								{
									"key": "terms.enforcement",
									"label": "Enforcement",
									"valueLabels": {
										"none": "No",
										"warning": "Warning",
										"full": "Yes"
									}
								}
							],
							"emptyText": "No mandates for this organisation yet"
						}
					},
					{
						"id": "organisation-billing",
						"type": "object-list",
						"title": "Billing",
						"content": {
							"register": "dossiq",
							"schema": "tenantBillingEvent",
							"filter": {
								"tenantRef": "@objectId"
							},
							"sort": {
								"field": "occurredAt",
								"dir": "desc"
							},
							"limit": 5,
							"columns": [
								{
									"key": "occurredAt",
									"label": "Date"
								},
								{
									"key": "eventType",
									"label": "Event"
								},
								{
									"key": "unitPrice",
									"label": "Amount"
								}
							],
							"emptyText": "No billing events yet. Events never change afterwards; a correction is a new line."
						}
					},
					{
						"id": "organisation-users",
						"type": "object-list",
						"title": "Users",
						"content": {
							"register": "dossiq",
							"schema": "tenantUser",
							"filter": {
								"tenantRef": "@objectId"
							},
							"limit": 50,
							"columns": [
								{
									"key": "userRef",
									"label": "User"
								},
								{
									"key": "role",
									"label": "Role"
								},
								{
									"key": "lastActiveAt",
									"label": "Last active"
								},
								{
									"key": "mfaEnabled",
									"label": "Two-step sign-in"
								}
							],
							"emptyText": "No users in this organisation yet"
						}
					},
					{
						"id": "organisation-mandates-list",
						"type": "object-list",
						"title": "Mandates",
						"content": {
							"register": "dossiq",
							"schema": "tenantMandate",
							"filter": {
								"tenantRef": "@objectId"
							},
							"limit": 50,
							"columns": [
								{
									"key": "mandateMatrixRef",
									"label": "Mandate"
								},
								{
									"key": "effectiveFrom",
									"label": "From"
								},
								{
									"key": "effectiveTo",
									"label": "Until"
								},
								{
									"key": "signedBy",
									"label": "Signed by"
								}
							],
							"emptyText": "No mandates for this organisation yet"
						}
					},
					{
						"id": "organisation-billing-list",
						"type": "object-list",
						"title": "Billing",
						"content": {
							"register": "dossiq",
							"schema": "tenantBillingEvent",
							"filter": {
								"tenantRef": "@objectId"
							},
							"sort": {
								"field": "occurredAt",
								"dir": "desc"
							},
							"limit": 50,
							"columns": [
								{
									"key": "occurredAt",
									"label": "Date"
								},
								{
									"key": "eventType",
									"label": "Event"
								},
								{
									"key": "quantity",
									"label": "Quantity"
								},
								{
									"key": "unitPrice",
									"label": "Amount"
								}
							],
							"emptyText": "No billing events yet"
						}
					}
				],
				"layout": [
					{
						"id": "1",
						"widgetId": "organisation-panels",
						"gridX": 0,
						"gridY": 0,
						"gridWidth": 12,
						"gridHeight": 24,
						"showTitle": false
					}
				]
			}
		}
	]
}
