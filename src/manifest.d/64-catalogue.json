{
	"_meta": {
		"spdx-license": "EUPL-1.2",
		"spdx-copyright": "2026 Conduction B.V.",
		"board": "DqCatalogus",
		"why": "One page that points at everything a case type is built from: the case types, the attributes, the templates and the object types, and what came in from the Store. Each part keeps its own page; this one only lists and links."
	},
	"menu": [
		{
			"id": "CatalogueMenu",
			"label": "Catalogue",
			"icon": "BookOpenPageVariantOutline",
			"route": "Catalogue",
			"section": "settings",
			"order": 89,
			"permission": "admin"
		}
	],
	"pages": [
		{
			"id": "Catalogue",
			"route": "/settings/catalogue",
			"type": "dashboard",
			"title": "Catalogue",
			"config": {
				"breadcrumb": { "label": "Settings", "href": "/index.php/settings/admin/dossiq" },
				"headerMeta": "case types, attributes, templates and object types in folders",
				"allowEdit": false,
				"gridFloat": false,
				"showWidgetActions": false,
				"documentationUrl": "https://dossiq.conduction.nl",
				"_headerActionsNote": "Board DqCatalogus: Downloaden, the Actions menu, the buildiq square and New object type. Download asks the object types table for its rows as CSV (exportId, nextcloud-vue feat/header-download-table-csv). An object type is an OpenRegister schema, so New object type opens OpenRegister's schemas, where Add schema creates one. A new case type starts on the Case types page the tree opens.",
				"headerActions": [
					{
						"id": "catalogue-download",
						"label": "Download",
						"icon": "TrayArrowDown",
						"type": "export",
						"exportId": "catalogue-object-types"
					},
					{
						"id": "catalogue-new-object-type",
						"label": "New object type",
						"icon": "Plus",
						"href": "/apps/openregister/schemas",
						"variant": "primary"
					}
				],
				"widgets": [
					{
						"id": "catalogue-folders",
						"type": "menu",
						"title": "Catalogue",
						"content": {
							"style": "tree",
							"activeItemHighlight": "background",
							"expandedByDefault": true,
							"showIcons": false,
							"items": [
								{
									"label": "Case types",
									"url": "/index.php/apps/dossiq/settings/case-types",
									"childrenFrom": { "register": "dossiq", "schema": "caseType", "field": "category", "url": "/index.php/apps/dossiq/settings/case-types?category={value}" },
									"countFrom": { "register": "dossiq", "schema": "caseType", "filter": { "supersededBy": { "isnull": true } } }
								},
								{ "label": "Attributes", "url": "/index.php/apps/dossiq/settings/attributes", "countFrom": { "register": "dossiq", "schema": "propertyDefinition" } },
								{ "label": "Templates", "url": "/index.php/apps/dossiq/settings/workflow-definitions", "countFrom": { "register": "dossiq", "schema": "workflowTemplate" } },
								{ "label": "Object types", "url": "/index.php/apps/dossiq/settings/catalogue", "countFrom": { "url": "/apps/dossiq/api/catalogue/object-types", "responsePath": "results" } }
							]
						}
					},
					{
						"id": "catalogue-object-types",
						"type": "object-table",
						"title": "Object types",
						"subtitle": "Objects you link to cases; you manage their properties here",
						"headerActions": [
							{
								"label": "Add object type",
								"icon": "Plus",
								"action": {
									"type": "navigate",
									"target": "/index.php/apps/openregister/schemas"
								}
							}
						],
						"subtitle": "Objects you link to cases, by type",
						"content": {
							"endpointSource": {
								"url": "/apps/dossiq/api/catalogue/object-types",
								"responsePath": "results"
							},
							"columns": [
								{ "key": "title", "label": "Object type", "cellClass": "cn-cell--strong", "secondary": "{schema}" },
								{ "key": "properties", "label": "Schema", "formatter": "propertyCount", "sortable": false },
								{ "key": "views", "label": "Display", "formatter": "objectViews", "sortable": false },
								{ "key": "cases", "label": "Used in", "formatter": "caseCount" }
							],
							"emptyText": "Object types appear here once cases link objects.",
							"pageSize": 4,
							"exportId": "catalogue-object-types",
							"exportFileName": "object-types"
						}
					},
					{
						"id": "catalogue-store",
						"type": "record-list",
						"title": "From the Store",
						"subtitle": "Case types and set-up in and out as a file",
						"content": {
							"endpointSource": {
								"url": "/apps/dossiq/api/store/items",
								"responsePath": "cards"
							},
							"presentation": "rows",
							"title": "{title}",
							"meta": "{summary}",
							"headerLink": { "label": "Store", "route": "Store" },
							"emptyText": "No Store connected. Connect one under Settings to install case types from it."
						}
					}
				],
				"layout": [
					{ "id": "1", "widgetId": "catalogue-folders", "gridX": 0, "gridY": 0, "gridWidth": 3, "gridHeight": 5, "showTitle": false, "sizeToContent": true },
					{ "id": "2", "widgetId": "catalogue-object-types", "gridX": 3, "gridY": 0, "gridWidth": 9, "gridHeight": 7, "showTitle": true, "sizeToContent": true },
					{ "id": "3", "widgetId": "catalogue-store", "gridX": 3, "gridY": 7, "gridWidth": 9, "gridHeight": 4, "showTitle": true, "sizeToContent": true }
				]
			}
		}
	]
}
