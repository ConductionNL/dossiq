{
	"_meta": {
		"spdx-license": "EUPL-1.2",
		"spdx-copyright": "2026 Conduction B.V.",
		"change": "inbound-mail-filters",
		"why-endpoint": "The intake log holds the original source of every message the mailbox received, and the intake-role check that guards it lives in MailIntakeController. So the index reads dossiq's /api/mail-intake/log (entitySource endpoint), never the generic OpenRegister object endpoint, which applies the register's permissions rather than the intake role."
	},
	"menu": [
		{
			"id": "MailIntakeLogMenu",
			"label": "Mail intake log",
			"icon": "EmailSearchOutline",
			"route": "MailIntakeLog",
			"section": "footer",
			"order": 95
		}
	],
	"pages": [
		{
			"id": "MailIntakeLog",
			"route": "/mail-intake-log",
			"type": "index",
			"title": "Mail intake log",
			"config": {
				"documentationUrl": "https://dossiq.conduction.nl",
				"entitySource": "endpoint",
				"sourceConfig": {
					"url": "/apps/dossiq/api/mail-intake/log",
					"rowsPath": "results",
					"searchParam": "sender",
					"notePath": "filterOrder",
					"noteText": "Filters run in this order: {order}",
					"refusedText": "You do not have the intake role, so you cannot read this log. It holds the original of every message the mailbox received. Ask an administrator to add you to the intake group."
				},
				"showTitle": true,
				"description": "Every message the intake mailbox processed. You see the filter that decided and what the sender checks found. A message that became no case says why.",
				"emptyText": "No message matches this search. A message we never received leaves no entry. Neither does one your mail server filtered before it reached the folder.",
				"inlineSearch": true,
				"searchPlaceholder": "Search by sender",
				"showAdd": false,
				"showViewAction": false,
				"showEditAction": false,
				"showCopyAction": false,
				"showDeleteAction": false,
				"allowSavedViews": false,
				"quickFilters": [
					{"label": "Every outcome", "filter": {}, "default": true},
					{"label": "Became a case", "filter": {"outcome": "case"}},
					{"label": "Held for a person", "filter": {"outcome": "quarantined"}},
					{"label": "Released by hand", "filter": {"outcome": "released"}},
					{"label": "Waiting in the intake inbox", "filter": {"outcome": "inbox"}},
					{"label": "Refused", "filter": {"outcome": "refused"}},
					{"label": "Sent on to another body", "filter": {"outcome": "forwarded"}},
					{"label": "Filed in another folder", "filter": {"outcome": "moved"}}
				],
				"columns": [
					{"key": "sender", "label": "Sender", "cellClass": "cn-cell--strong"},
					{"key": "subject", "label": "Subject"},
					{"key": "decided", "label": "Deciding filter"},
					{"key": "spfResult", "label": "SPF", "widget": "badge", "enum": ["pass", "fail", "none", "unavailable"], "enumLabels": {"pass": "passed", "fail": "failed", "none": "no policy published", "unavailable": "not checked"}, "colorMap": {"pass": "success", "fail": "error", "none": "default", "unavailable": "default"}},
					{"key": "dkimResult", "label": "DKIM", "widget": "badge", "enum": ["pass", "fail", "none", "unavailable"], "enumLabels": {"pass": "passed", "fail": "failed", "none": "no policy published", "unavailable": "not checked"}, "colorMap": {"pass": "success", "fail": "error", "none": "default", "unavailable": "default"}},
					{"key": "dmarcResult", "label": "DMARC", "widget": "badge", "enum": ["pass", "fail", "none", "unavailable"], "enumLabels": {"pass": "passed", "fail": "failed", "none": "no policy published", "unavailable": "not checked"}, "colorMap": {"pass": "success", "fail": "error", "none": "default", "unavailable": "default"}},
					{"key": "threadingResult", "label": "Threading", "widget": "badge", "enum": ["pass", "fail", "none", "unavailable"], "enumLabels": {"pass": "passed", "fail": "failed", "none": "no policy published", "unavailable": "not checked"}, "colorMap": {"pass": "success", "fail": "error", "none": "default", "unavailable": "default"}},
					{"key": "outcome", "label": "Outcome", "enum": ["case", "quarantined", "released", "inbox", "refused", "forwarded", "moved"], "enumLabels": {"case": "Became a case", "quarantined": "Held for a person", "released": "Released by hand", "inbox": "Waiting in the intake inbox", "refused": "Refused", "forwarded": "Sent on to another body", "moved": "Filed in another folder"}},
					{"key": "reason", "label": "Reason", "secondary": "{junkReason}"},
					{"key": "actions", "label": "", "widget": "actions", "widgetProps": {"actions": ["release", "not-junk", "file-on-case"]}}
				],
				"actions": [
					{
						"id": "release",
						"label": "Release",
						"variant": "secondary",
						"type": "open-modal",
						"target": "CnActionDialog",
						"visibleWhen": {"field": "outcome", "op": "eq", "value": "quarantined"},
						"props": {
							"config": {
								"title": "Release this message?",
								"summary": {"title": "{subject}", "meta": "{sender}", "icon": "EmailOutline"},
								"doneText": "The message went on into a case.",
								"confirm": {"label": "Release", "request": {"method": "POST", "url": "/apps/dossiq/api/mail-intake/log/@objectId/release"}}
							}
						}
					},
					{
						"id": "not-junk",
						"label": "Not junk",
						"variant": "tertiary",
						"type": "open-modal",
						"target": "CnActionDialog",
						"visibleWhen": {"field": "junkRule", "op": "notEmpty"},
						"props": {
							"config": {
								"title": "This message is not junk?",
								"summary": {"title": "{subject}", "meta": "{junkReason}", "icon": "EmailOutline"},
								"doneText": "The message goes through the filters again.",
								"confirm": {"label": "Not junk", "request": {"method": "POST", "url": "/apps/dossiq/api/mail-intake/log/@objectId/junk", "body": {"junk": false}}}
							}
						}
					},
					{
						"id": "file-on-case",
						"label": "File on a case",
						"variant": "tertiary",
						"type": "open-modal",
						"target": "MailIntakeFileOnCaseDialog"
					}
				]
			},
			"_note": "inbound-mail-filters: the intake log as an endpoint index. The endpoint keeps the intake-role check and answers 403 with the sentence the page shows instead of the rows; every result cell is pass, fail, no policy or not checked in words (the server reads a missing check as `unavailable`, never blank); the deciding filter and the junk rule come named from the server. Release and Not junk confirm through CnActionDialog, which shows the server's refusal; File on a case is offered on every row, since a wrong match looks like a right one until a person reads it."
		}
	]
}
