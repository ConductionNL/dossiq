{
  "name": "procest",
  "version": "0.1.0",
  "license": "EUPL-1.2",
  "engines": {
    "node": "^20.0.0",
    "npm": "^10.0.0"
  },
  "scripts": {
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage --coverage.provider=v8 --coverage.reporter=json-summary --coverage.reporter=text-summary --coverage.include=src/** --coverage.reportsDirectory=coverage-vitest",
    "test:coverage-ratchet": "npm run test:coverage && bash tests/coverage-ratchet.sh vitest coverage-vitest/coverage-summary.json",
    "check:manifest": "node tests/validate-manifest.js",
    "test:unit:watch": "vitest",
    "test:l10n": "node tests/l10n/check-l10n.js",
    "test:l10n:write": "node tests/l10n/check-l10n.js --write",
    "prebuild": "vue-demi-switch 2.7",
    "build": "NODE_ENV=production webpack --config webpack.config.js --progress",
    "predev": "vue-demi-switch 2.7",
    "dev": "NODE_ENV=development webpack --config webpack.config.js --progress",
    "prewatch": "vue-demi-switch 2.7",
    "watch": "NODE_ENV=development webpack --config webpack.config.js --progress --watch",
    "lint": "eslint src",
    "lint-fix": "npm run lint -- --fix",
    "stylelint": "stylelint src/**/*.vue src/**/*.scss src/**/*.css",
    "stylelint-fix": "stylelint src/**/*.vue src/**/*.scss src/**/*.css --fix",
    "test:zgw": "cd tests/zgw && bash run-zgw-tests.sh",
    "test:zgw:oas": "cd tests/zgw && bash run-zgw-tests.sh --oas-only",
    "test:zgw:business": "cd tests/zgw && bash run-zgw-tests.sh --business-only",
    "test:e2e": "playwright test",
    "test:e2e:docs": "playwright test --project docs-capture",
    "test:e2e:install": "playwright install chromium"
  },
  "browserslist": [
    "extends @nextcloud/browserslist-config"
  ],
  "dependencies": {
    "@conduction/nextcloud-vue": "^1.0.0-beta.190",
    "@nextcloud/auth": "^2.6.0",
    "@nextcloud/axios": "~2.5.2",
    "@nextcloud/dialogs": "^6.4.2",
    "@nextcloud/initial-state": "^2.2.0",
    "@nextcloud/l10n": "^2.0.1",
    "@nextcloud/password-confirmation": "^5.3.2",
    "@nextcloud/router": "^2.0.1",
    "@nextcloud/vue": "^8.39.0",
    "dexie": "4.4.4",
    "gridstack": "^10.3.1",
    "leaflet": "^1.9.4",
    "leaflet-draw": "^1.0.4",
    "pinia": "^2.1.7",
    "proj4": "^2.20.4",
    "vue": "^2.7.14",
    "vue-material-design-icons": "^5.3.0",
    "vue-router": "^3.6.5"
  },
  "overrides": {
    "@nextcloud/axios": "~2.5.2",
    "minimatch": "^3.1.2"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/eslint-parser": "^7.28.6",
    "@cyclonedx/cyclonedx-npm": "^4.2.1",
    "@eslint/config-helpers": "^0.4.2",
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.39.1",
    "@nextcloud/browserslist-config": "^3.0.1",
    "@nextcloud/eslint-config": "^8.4.1",
    "@nextcloud/eslint-plugin": "^2.2.1",
    "@nextcloud/stylelint-config": "^2.4.0",
    "@nextcloud/webpack-vue-config": "^6.0.1",
    "@playwright/test": "^1.49.0",
    "@vitejs/plugin-vue2": "^2.3.4",
    "@vitest/coverage-v8": "^1.6.1",
    "@vue/eslint-config-typescript": "^13.0.0",
    "@vue/test-utils": "^1.3.6",
    "commander": "^12.1.0",
    "css-loader": "~7.1.1",
    "eslint": "^8.56.0",
    "eslint-config-standard": "^17.1.0",
    "eslint-import-resolver-alias": "^1.1.2",
    "eslint-import-resolver-exports": "^1.0.0-beta.5",
    "eslint-import-resolver-typescript": "^3.10.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsdoc": "^46.10.1",
    "eslint-plugin-n": "^16.6.2",
    "eslint-plugin-promise": "^6.6.0",
    "eslint-plugin-vue": "^9.33.0",
    "jsdom": "^24.1.3",
    "node-polyfill-webpack-plugin": "^3.0.0",
    "postcss-html": "^1.8.1",
    "sass": "^1.101.0",
    "sass-loader": "^16.0.8",
    "style-loader": "~4.0.0",
    "stylelint": "^15.11.0",
    "stylelint-config-recommended-scss": "^13.1.0",
    "stylelint-config-recommended-vue": "^1.6.1",
    "typescript": "^5.9.3",
    "vitest": "^1.6.1",
    "vue-loader": "^15.11.1 <16.0.0",
    "vue-template-compiler": "^2.7.16",
    "webpack": "^5.94.0",
    "webpack-cli": "^6.0.1"
  }
}
