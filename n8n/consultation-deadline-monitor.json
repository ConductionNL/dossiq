{
  "name": "Dossiq — Consultation Deadline Monitor",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 24
            }
          ]
        }
      },
      "id": "daily-trigger",
      "name": "Daily at 07:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [
        200,
        300
      ]
    },
    {
      "parameters": {
        "url": "={{ $env.DOSSIQ_BASE_URL || 'http://nextcloud' }}/index.php/apps/dossiq/api/consultations/overdue",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpBasicAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "OCS-APIRequest",
              "value": "true"
            },
            {
              "name": "Accept",
              "value": "application/json"
            }
          ]
        }
      },
      "id": "fetch-overdue",
      "name": "GET /consultations/overdue",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        420,
        200
      ]
    },
    {
      "parameters": {
        "url": "={{ $env.DOSSIQ_BASE_URL || 'http://nextcloud' }}/index.php/apps/dossiq/api/consultations/due-soon",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpBasicAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "OCS-APIRequest",
              "value": "true"
            },
            {
              "name": "Accept",
              "value": "application/json"
            }
          ]
        }
      },
      "id": "fetch-warning",
      "name": "GET /consultations/due-soon (warning offset)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        420,
        400
      ]
    },
    {
      "parameters": {
        "jsCode": "// Compose two streams: due soon (within the warning offset set in\n// Adviseringsbeheer, GET /api/consultations/due-soon) and overdue (past\n// latestResponseDate, GET /api/consultations/overdue). Each consultation ->\n// a notification for its advisory body.\nconst dueSoon = $input.first().json || {};\nconst warning = dueSoon.results || [];\nconst offset = Number(dueSoon.warningOffsetDays || 0);\nconst overdue = ($input.last().json || {}).results || [];\nconst today = new Date().toISOString().slice(0, 10);\nconst daysUntil = (date) => Math.round((Date.parse(date) - Date.parse(today)) / 86400000);\nconst notifications = [];\nfor (const c of warning) {\n  notifications.push({\n    consultationId: c.id,\n    consultationNummer: c.consultationNumber,\n    caseId: c.parentCase,\n    adviesinstantieId: c.advisoryBodyId || c.adviceAuthority,\n    priority: 'warning',\n    template: 'consultation-deadline-warning',\n    daysRemaining: daysUntil(c.latestResponseDate),\n    warningOffsetDays: offset,\n    deadline: c.latestResponseDate\n  });\n}\nfor (const c of overdue) {\n  notifications.push({\n    consultationId: c.id,\n    consultationNummer: c.consultationNumber,\n    caseId: c.parentCase,\n    adviesinstantieId: c.advisoryBodyId || c.adviceAuthority,\n    priority: 'overdue',\n    template: 'consultation-deadline-overdue',\n    deadline: c.latestResponseDate\n  });\n}\nreturn notifications.map(n => ({ json: n }));"
      },
      "id": "merge",
      "name": "Build notification list",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        640,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.DOSSIQ_BASE_URL || 'http://nextcloud' }}/index.php/apps/dossiq/api/notifications/send",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpBasicAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "OCS-APIRequest",
              "value": "true"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"adviesinstantieId\": $json.adviesinstantieId,\n  \"template\": $json.template,\n  \"priority\": $json.priority,\n  \"context\": {\n    \"consultationId\": $json.consultationId,\n    \"consultationNummer\": $json.consultationNummer,\n    \"caseId\": $json.caseId,\n    \"deadline\": $json.deadline,\n    \"daysRemaining\": $json.daysRemaining\n  }\n}"
      },
      "id": "send-notification",
      "name": "POST /api/notifications/send",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        860,
        300
      ]
    }
  ],
  "connections": {
    "Daily at 07:00": {
      "main": [
        [
          {
            "node": "GET /consultations/due-soon (warning offset)",
            "type": "main",
            "index": 0
          },
          {
            "node": "GET /consultations/overdue",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "GET /consultations/overdue": {
      "main": [
        [
          {
            "node": "Build notification list",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Build notification list": {
      "main": [
        [
          {
            "node": "POST /api/notifications/send",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "GET /consultations/due-soon (warning offset)": {
      "main": [
        [
          {
            "node": "Build notification list",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "callerPolicy": "workflowsFromSameOwner"
  },
  "meta": {
    "templateCredsSetupCompleted": false,
    "owner": "dossiq",
    "spec": "openspec/changes/consultation-management/specs/consultation-management/spec.md#deadline-warning",
    "purpose": "Daily 07:00 scan: T-5 warnings via /consultations?deadlineWithin=P5D; overdue escalations via /consultations/overdue. Internal bodies are notified via Nextcloud groups; external bodies via configured email."
  }
}
