{
  "name": "Dossiq — Consultation Bottleneck Detection",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 24
            }
          ]
        }
      },
      "id": "daily-trigger",
      "name": "Daily at 08:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [
        200,
        300
      ]
    },
    {
      "parameters": {
        "url": "={{ $env.DOSSIQ_BASE_URL || 'http://nextcloud' }}/index.php/apps/dossiq/api/consultations/bottlenecks",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpBasicAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "OCS-APIRequest",
              "value": "true"
            },
            {
              "name": "Accept",
              "value": "application/json"
            }
          ]
        }
      },
      "id": "fetch-analytics",
      "name": "GET /consultations/bottlenecks (last 30d)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        420,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// Bottleneck rule: alert the coordinators about every advisory body whose\n// late share over the last 30 days passes the threshold set in\n// Adviseringsbeheer. dossiq computes the report and the flag\n// (GET /api/consultations/bottlenecks: { threshold, windowDays, bodies:\n// [{ adviceAuthority, total, late, lateShare, flagged }] }).\nconst payload = $input.first().json || {};\nconst alerts = (payload.bodies || []).filter((b) => b.flagged === true).map((b) => ({\n  adviesinstantieId: b.adviceAuthority,\n  naam: b.adviceAuthority,\n  overdueCount: b.late,\n  overdueRate: Math.round(Number(b.lateShare || 0) * 100),\n  threshold: Math.round(Number(payload.threshold || 0) * 100),\n  message: `${b.adviceAuthority}: ${b.late} van ${b.total} adviezen te laat in ${payload.windowDays} dagen (${Math.round(Number(b.lateShare || 0) * 100)}%, drempel ${Math.round(Number(payload.threshold || 0) * 100)}%).`\n}));\nreturn alerts.length ? alerts.map(a => ({ json: a })) : [{ json: { _empty: true } }];"
      },
      "id": "rule",
      "name": "Keep the flagged bodies",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        640,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "has-alerts",
              "leftValue": "={{ $json._empty }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "notEquals"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "if-alert",
      "name": "Any bottlenecks?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        860,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.DOSSIQ_BASE_URL || 'http://nextcloud' }}/index.php/apps/dossiq/api/notifications/send",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpBasicAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "OCS-APIRequest",
              "value": "true"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"recipientGroup\": \"consultation-coordinators\",\n  \"template\": \"consultation-bottleneck-alert\",\n  \"priority\": \"warning\",\n  \"context\": {\n    \"adviesinstantieId\": $json.adviesinstantieId,\n    \"naam\": $json.naam,\n    \"overdueCount\": $json.overdueCount,\n    \"overdueRatePct\": $json.overdueRate,\n    \"thresholdPct\": $json.threshold,\n    \"message\": $json.message\n  }\n}"
      },
      "id": "alert",
      "name": "Notify coordinator group",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1080,
        220
      ]
    }
  ],
  "connections": {
    "Daily at 08:00": {
      "main": [
        [
          {
            "node": "GET /consultations/bottlenecks (last 30d)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Any bottlenecks?": {
      "main": [
        [
          {
            "node": "Notify coordinator group",
            "type": "main",
            "index": 0
          }
        ],
        []
      ]
    },
    "GET /consultations/bottlenecks (last 30d)": {
      "main": [
        [
          {
            "node": "Keep the flagged bodies",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Keep the flagged bodies": {
      "main": [
        [
          {
            "node": "Any bottlenecks?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "callerPolicy": "workflowsFromSameOwner"
  },
  "meta": {
    "templateCredsSetupCompleted": false,
    "owner": "dossiq",
    "spec": "openspec/changes/consultation-management/specs/consultation-management/spec.md#bottleneck-detection",
    "purpose": "Daily 08:00 bottleneck scan per advisory body using a 30-day analytics window. Emits a coordinator-group notification when overdue rate > 20% (spec rule)."
  }
}
